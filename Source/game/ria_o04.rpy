label ria_o04_offer:
    if not dating or active_route != "ria" or "ria_R15" not in completed or memory.get("ria_o04_outcome"):
        return
    if not any(memory.get(key) == "shared" for key in ("ria_r07_intimacy", "ria_r12_intimacy", "ria_r15_intimacy")):
        return

    $ progression_enter("ria_o04_offer")
    $ progression_checkpoint("ria_o04_offer")
    $ chapter = "리아 O04 · 오늘은 길 안 잃었어"
    $ location = "목요일 퇴근 후 · 온빛브랜딩 앞"
    "건물 밖에 나오자 리아가 도현의 소매를 잡았다. 신호가 바뀌었는데도 리아는 건너지 않았다."
    r "[ri('오늘 바로 집에 가? 역 뒤에 내가 좋아하는 포차 있어. 한잔할래?', '오늘 바로 집에 가세요? 역 뒤에 제가 좋아하는 포차 있어요. 한잔하실래요?')]"
    $ progression_enter("ria_o04_offer.choice01")
    $ progression_checkpoint("ria_o04_offer.choice01")
    menu:
        "리아 단골 포차로 간다.":
            d "[ri('좋아. 대신 안주는 네가 시켜. 단골이잖아.', '좋아요. 대신 안주는 리아 씨가 시켜 주세요. 단골이잖아요.')]"
        "오늘은 그냥 집에 간다.":
            d "[ri('오늘은 집에서 쉴래. 가게 이름만 알려 줘.', '오늘은 집에서 쉴게요. 가게 이름만 알려 주세요.')]"
            r "[ri('싫어~ 처음은 무조건 내가 데려갈 거야. 잘 들어가!', '싫어요~ 처음은 무조건 제가 데려갈 거예요. 잘 들어가세요!')]"
            $ remember("ria_o04_outcome", "skipped")
            return

    $ location = "목요일 저녁 · 역 뒤 골목 포차"
    "리아는 메뉴판을 펴기도 전에 두부김치와 소주를 주문했다. 주인은 리아 앞에 물컵을 놓으며 오늘은 두부를 한 조각 더 줬다고 귀띔했다."
    r "[ri('나 여기는 소주 마시러 와. 두부는 하나 더 받으려고 자주 오고~', '저 여기 소주 마시러 와요. 두부는 하나 더 받으려고 자주 오고요~')]"
    d "[ri('그럼 한 조각 더 받은 건 네 거네.', '그럼 한 조각 더 받은 건 리아 씨 거네요.')]"
    "리아는 대답 대신 그 조각을 반으로 잘랐다. 큰 쪽을 도현 접시에 올리고는 들켰냐는 듯 웃었다."
    "소주는 작은 잔으로 딱 한 잔씩. 접시를 다 비울 때까지 나머지는 물이었다."

    $ location = "목요일 밤 · 역 앞"
    "포차에서 나와 역 앞에 섰다. 도현이 지하철 입구 쪽으로 몸을 돌렸는데 리아는 잡고 있던 손을 놓지 않았다."
    r "[ri('오늘은 길 안 잃었어. 너랑 헤어지기 싫어서 멈춘 거야.', '오늘은 길 안 잃었어요. 도현 씨랑 헤어지기 싫어서 멈춘 거예요.')]"
    d "[ri('그럼 한 블록만 더 걸을까?', '그럼 한 블록만 더 걸을까요?')]"
    r "[ri('오늘은 걷는 거 말고.', '오늘은 걷는 거 말고요.')]"
    "리아가 길 건너 작은 모텔 간판을 가리켰다가 손을 내렸다. 잠깐 뜸을 들인 뒤 도현을 똑바로 봤다."
    r "[ri('저기 들어가서 둘이 좀 더 있을래? 너도 그러고 싶으면.', '저기 들어가서 둘이 좀 더 있을래요? 도현 씨도 그러고 싶으시면요.')]"
    $ progression_enter("ria_o04_offer.choice02")
    $ progression_checkpoint("ria_o04_offer.choice02")
    menu:
        "리아와 모텔로 들어간다.":
            d "[ri('나도 너랑 더 있고 싶어. 같이 가자.', '저도 리아 씨랑 더 있고 싶어요. 같이 가요.')]"
            "리아가 반 걸음 앞서 나갔다가 신호등 앞에서 멈췄다. 손을 내밀자 도현이 손가락 사이로 자기 손을 끼웠다."
            $ location = "목요일 밤 · 역 앞 모텔"
            "방에 들어오자 리아는 가방을 의자에 걸고 문 옆에 기대었다. 조금 전까지 잡고 있던 손을 내려다보고는 한 발 다가왔다."
            r "[ri('이제는 손만 잡고 있기가 좀 아까운데. 키스해도 돼?', '이제는 손만 잡고 있기가 좀 아까운데요. 키스해도 돼요?')]"
            d "[ri('응. 나도 아까부터 그러고 싶었어.', '네. 저도 아까부터 그러고 싶었어요.')]"
            "도현이 몸을 기울이기도 전에 리아가 입을 맞췄다. 창 아래로 마지막 열차가 지나가는 소리가 났다."
            $ remember("ria_o04_outcome", "motel")
            scene bg plain with fade
        "손잡고 조금 더 걷는다.":
            d "[ri('나도 더 있고 싶어. 오늘은 손 잡고 조금만 더 걷고 싶어.', '저도 더 있고 싶어요. 오늘은 손 잡고 조금만 더 걷고 싶어요.')]"
            r "[ri('좋아! 오늘 코스는 네가 짜. 길 잃으면 네 탓~', '좋아요! 오늘 코스는 도현 씨가 짜요. 길 잃으면 도현 씨 탓~')]"
            "도현은 큰길 옆 작은 골목으로 꺾었다. 문 닫은 세탁소를 지날 때 리아가 그의 팔에 어깨를 붙였다. 한 블록을 더 걷고서야 역으로 돌아갔다."
            $ remember("ria_o04_outcome", "walk")
        "역에서 인사하고 헤어진다.":
            d "[ri('오늘은 여기서 인사할래. 같이 먹은 거 좋았어.', '오늘은 여기서 인사할게요. 같이 먹은 거 좋았어요.')]"
            r "[ri('나도! 근데 다음엔 두부 큰 쪽 네가 양보해야 된다~', '저도요! 근데 다음엔 두부 큰 쪽 도현 씨가 양보하셔야 돼요~')]"
            "도현이 개찰구를 지나 뒤를 봤다. 리아는 손가락으로 반을 가르는 시늉을 하다가 웃으며 손을 흔들었다."
            $ remember("ria_o04_outcome", "home")

    $ location = "금요일 아침 · 개인 메시지"
    if memory.get("ria_o04_outcome") == "motel":
        call phone_deliver("ria_o04_morning_motel", "ria", ri("아침에 그 역 지나는데 어제 네가 잡아 준 손만 주머니에 넣고 걷게 되더라. 저녁에도 손 잡을래 :)", "아침에 그 역 지나는데 어제 도현 씨가 잡아 주신 손만 주머니에 넣고 걷게 되더라고요. 저녁에도 손 잡을래요 :)"), important=True)
    elif memory.get("ria_o04_outcome") == "walk":
        call phone_deliver("ria_o04_morning_walk", "ria", ri("어제 네가 고른 골목도 지도에 넣었어. 세탁소 옆에 별 하나 더 생겼네~", "어제 도현 씨가 고른 골목도 지도에 넣었어요. 세탁소 옆에 별 하나 더 생겼네요~"), important=True)
    else:
        call phone_deliver("ria_o04_morning_home", "ria", ri("어제 잘 잤어? 다음에 두부는 내가 자르고 네가 고르기. 양보 금지~", "어제 잘 주무셨어요? 다음에 두부는 제가 자르고 도현 씨가 고르기. 양보 금지~"), important=True)
    return
