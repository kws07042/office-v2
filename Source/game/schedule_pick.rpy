# 일정 선택 — 공통 구간에서 세 번(C04 뒤 점심, C05 뒤 야근, C06 뒤 퇴근길) 누구와 보낼지 고른다.
# 고른 사람은 x_sched_<n>에 남고, 크리스마스 '마음 점수'에 1점씩 더해진다. 기존 호감도는 건드리지 않는다.
# 고르지 않은 사람 중 한 명이 그날 밤 짧은 메시지를 보낸다.

init python:
    SCHED_ORDER = ("ria", "jihyun", "yujin", "seoyun")
    SCHED_NAMES = {"ria": "리아", "jihyun": "지현", "yujin": "유진", "seoyun": "서윤"}

    def sched_count(who):
        mem = renpy.store.memory
        return sum(1 for n in (1, 2, 3) if mem.get("x_sched_%d" % n) == who)

    def sched_most():
        counts = [(sched_count(w), w) for w in SCHED_ORDER]
        best = max(counts)
        if best[0] < 2:
            return None
        return best[1]

    def sched_next_other(who):
        i = SCHED_ORDER.index(who)
        return SCHED_ORDER[(i + 1) % 4]

label schedule_pick(slot):
    $ chapter = ["", "C04 · 점심, 누구와", "C05 · 야근, 누구와", "C06 · 퇴근길, 누구와"][slot]
    if slot == 1:
        $ location = "그 주 목요일 · 점심시간"
        "점심시간. 사무실이 반쯤 비었다. 오늘은 누구와 밥을 먹을까."
        menu:
            "강리아와 점심 — 현장 벤치에서 김밥":
                $ remember("x_sched_1", "ria")
            "백지현과 점심 — 모니터 앞 샌드위치":
                $ remember("x_sched_1", "jihyun")
            "차유진과 점심 — 계단참 창가":
                $ remember("x_sched_1", "yujin")
            "한서윤과 점심 — 서윤이 고른 식당":
                $ remember("x_sched_1", "seoyun")
    elif slot == 2:
        $ location = "다음 주 화요일 · 밤 아홉 시의 사무실"
        "밤 아홉 시. 불 꺼진 자리 사이로 아직 켜진 모니터가 몇 개 남아 있었다. 누구 쪽으로 가 볼까."
        menu:
            "강리아의 야근 — 현장 지도 다시 그리기":
                $ remember("x_sched_2", "ria")
            "백지현의 야근 — 마지막까지 켜진 스탠드":
                $ remember("x_sched_2", "jihyun")
            "차유진의 야근 — 같은 아이콘 스무 번":
                $ remember("x_sched_2", "yujin")
            "한서윤의 야근 — 늦은 클라이언트 전화":
                $ remember("x_sched_2", "seoyun")
    else:
        $ location = "그 주 금요일 · 퇴근길"
        "금요일 퇴근길. 엘리베이터 앞에 네 사람이 다 있었다. 누구와 같은 방향으로 걸을까."
        menu:
            "강리아와 퇴근 — 빵집 앞에서 느려지는 걸음":
                $ remember("x_sched_3", "ria")
            "백지현과 퇴근 — 같은 버스 정류장":
                $ remember("x_sched_3", "jihyun")
            "차유진과 퇴근 — 별표 친 골목으로":
                $ remember("x_sched_3", "yujin")
            "한서윤과 퇴근 — 같은 칸 지하철":
                $ remember("x_sched_3", "seoyun")
    $ sched_who = memory["x_sched_%d" % slot]
    call expression ("sched_%s_%d" % (sched_who, slot))
    $ sched_other = sched_next_other(sched_who)
    $ location = "그날 밤 · 개인 메시지"
    call expression ("sched_msg_%s_%d" % (sched_other, slot))
    return

