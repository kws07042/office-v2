# 특별 장면 — 루트마다 R06 뒤와 R11 뒤에 하나씩. 그 시점까지의 마음 점수가 기준 이상이면 열린다.
# 본 장면은 persistent에 남아 '우리의 기록' 관계 탭에 제목이 보이고, 못 본 장면은 '잠김'으로 보인다.

define SPECIAL_HEART = {1: 2, 2: 5}
define SPECIAL_TITLES = {
    "ria": ("코인 세탁방의 사십 분", "만약에, 라는 말"),
    "jihyun": ("일부러 남긴 실수", "계획 없는 이십 분"),
    "yujin": ("처음 그린 건 손", "올리지 않은 그림들"),
    "seoyun": ("잠들 때까지 한 쪽만", "오늘은 네가 맡아 줘"),
}

label special_scene(who, n):
    if not dating or active_route != who or memory.get("x_special_%s_%d" % (who, n)):
        return
    if xmas_heart(who) < SPECIAL_HEART[n]:
        return
    $ remember("x_special_%s_%d" % (who, n))
    $ setattr(persistent, "special_%s_%d" % (who, n), True)
    $ chapter = "특별 장면 · " + SPECIAL_TITLES[who][n - 1]
    call expression ("%s_sp%d" % (who, n))
    return

# ── 리아 ──────────────────────────────────────────────
label ria_sp1:
    $ location = "일요일 오후 · 동네 코인 세탁방"
    $ cream_focus = "ria"
    "일요일 오후. 리아가 보낸 메시지는 한 줄이었다. '빨래 돌리는데 사십 분 걸려. 와서 같이 아무것도 안 할래?'"
    $ cg("ria_sp1")
    "코인 세탁방의 플라스틱 의자에 나란히 앉았다. 세탁기 창 안에서 리아의 수건과 양말이 천천히 돌았다."
    r "[ri('빨래 끝날 때까지 그냥 앉아 있으려고. 가게 찾는 앱도 안 열고.', '저 이거 연습 중이에요. 아무것도 안 하는 거요. 도현 씨가 저번에 재미없어도 된다고 했잖아요.')]"
    d "[ri('어때?', '어때요?')]"
    r "[ri('...삼 분 만에 휴대폰 세 번 봤어. 망했어.', '...삼 분 만에 휴대폰 세 번 봤어요. 망했어요.')]"
    "도현이 손바닥을 내밀었다. 리아가 잠깐 망설이다 휴대폰을 그 위에 놓았다."
    "세탁기가 헹굼으로 넘어갔다. 물소리가 바뀌는 걸 둘이 동시에 알아챘고, 동시에 웃었다."
    r "[ri('이상하다. 이게 왜 웃기지.', '이상하다. 이게 왜 웃기죠.')]"
    d "[ri('너도 방금 헹굼 소리 나길 기다리고 있었어?', '웃기려고 한 게 아니라서 그런가 봐요.')]"
    "탈수가 시작될 무렵, 리아의 머리가 도현의 어깨에 기울었다. 잠든 건 아니었다. 그냥 기댄 거였다."
    r "[ri('사십 분 생각보다 짧다.', '사십 분 생각보다 짧네요.')]"
    dn "탈수까지 사십 분. 아무것도 안 했는데 다 갔네."
    $ cream_focus = None
    return

label ria_sp2:
    $ location = "목요일 밤 · 회사 옥상"
    $ cream_focus = "ria"
    $ cg("ria_sp2")
    "야근이 끝난 목요일 밤. 리아가 옥상에서 캔커피 두 개를 들고 기다리고 있었다. 요즘 답장이 조금씩 늦던 리아였다."
    r "[ri('하나만 물어봐도 돼? 그냥, 만약에 얘기야.', '하나만 여쭤봐도 돼요? 그냥, 만약에 얘기예요.')]"
    d "[ri('응.', '네.')]"
    r "[ri('만약에 내가 좀 먼 데로 가게 되면... 넌 어떻게 할 거야?', '만약에 제가 좀 먼 데로 가게 되면... 도현 씨는 어떻게 할 거예요?')]"
    "도현이 대답하기 전에 리아가 손을 내저었다."
    r "[ri('아니다, 대답하지 마. 진짜 만약이야. 지금 너무 진지한 얼굴 하잖아~', '아니다, 대답하지 마세요. 진짜 만약이에요. 지금 너무 진지한 얼굴 하시잖아요~')]"
    d "[ri('대답할게. 어디로 가든, 가기 전에 나한테 제일 먼저 말해 줘. 그거면 돼.', '대답할게요. 어디로 가든, 가기 전에 저한테 제일 먼저 말해 주세요. 그거면 돼요.')]"
    "리아가 캔을 따다 멈췄다. 웃음이 한 박자 늦게 돌아왔다."
    r "[ri('...제일 먼저. 알았어. 약속은 못 하는데, 기억은 할게.', '...제일 먼저요. 알았어요. 약속은 못 하는데, 기억은 할게요.')]"
    dn "만약이 무슨 뜻인지 묻고 싶었다. 리아가 먼저 캔을 들어서 나도 따라 들었다."
    $ cream_focus = None
    return

# ── 지현 ──────────────────────────────────────────────
label jihyun_sp1:
    $ location = "토요일 오후 · 지현의 집"
    $ cream_focus = "jihyun"
    "지현이 핀셋을 건넸다. 조립 중인 작은 집의 계단 난간, 가장 쉬운 부품이라고 했다."
    j "본드는 쌀알만큼. 그 이상이면 번져."
    $ cg("jihyun_sp1")
    "도현은 쌀알보다 조금 크게 짰다. 본드가 난간 끝에서 작게 번졌다."
    d "...망했네요. 다시 할게요."
    "지현이 손을 뻗었다가, 멈췄다. 그러고 손을 거뒀다."
    j "아니. 그대로 둬."
    d "팀장님이요? 번진 걸 그대로 두신다고요?"
    j "응. 이 집에서 내가 안 만든 데가 처음 생겼어. 그거 표시해 두고 싶어."
    "지현은 루페를 들고 번진 자국을 한참 봤다. 회의 자료의 오타를 볼 때와 같은 자세였는데, 표정이 달랐다."
    j "나중에 이 집 다 만들고 나서 보면, 여기만 좀 이상하겠지. 그러면 오늘이 생각날 거야."
    dn "루페 너머로 거기만 다시 봤다. 지현 씨가 그냥 두고 싶다던 자리."
    $ cream_focus = None
    return

label jihyun_sp2:
    $ location = "다음 주 화요일 저녁 · 지현의 집"
    $ cream_focus = "jihyun"
    "퇴근하고 들른 지현의 집. 저녁을 먹고 소파에 앉은 지현이 등을 기댔다. 요즘 주말에도 사무실에 나간다는 걸 도현은 알고 있었다."
    j "오 분만 눈 감을게. 오 분 뒤에 깨워."
    $ cg("jihyun_sp2")
    "지현은 정말로 휴대폰 알람을 오 분으로 맞추려 했다. 도현이 휴대폰을 살짝 가져갔다. 지현은 항의하려다, 그대로 잠들었다."
    "이십 분이 지났다. 지현이 놀란 얼굴로 눈을 떴다."
    j "...몇 분 지났어?"
    d "이십 분이요."
    j "오 분이라고 했잖아."
    d "깨울까 하다 그냥 뒀어요. 시간 정해 달라셨는데 제가 맘대로 했네요."
    "지현은 화를 내려다가 그만뒀다. 대신 손으로 얼굴을 덮었다."
    j "요즘 푹 잔 날이 기억이 안 나. 지금은 그래도 좀 잔 것 같다."
    dn "요즘 뭐 때문에 못 주무세요. 입안에서만 물었다."
    $ cream_focus = None
    return

# ── 유진 ──────────────────────────────────────────────
label yujin_sp1:
    $ location = "토요일 오후 · 공원 벤치"
    $ cream_focus = "yujin"
    "벤치에 앉자 유진이 스케치북을 무릎 위에 펼쳤다. 펜 끝이 도현 쪽을 향했다가 멈췄다."
    y "저, 도현 씨 그려도 돼요? 얼굴은 아니고요. ...얼굴은 아직 못 그리겠어요."
    d "그럼 어디?"
    y "손이요. 벤치 등받이에 올린 손."
    $ cg("yujin_sp1")
    "도현은 손을 그대로 두었다. 유진의 펜이 빠르게, 그러다 아주 느리게 움직였다. 십 분 동안 둘 다 말이 없었다."
    "유진이 스케치북을 돌려 보였다. 손이었다. 손가락 마디의 작은 흉터까지 있었다."
    d "이 흉터, 나도 잊고 있었는데."
    y "처음 회의 때부터 봤어요. 자료 넘길 때마다 보여서요."
    "말을 끝내자 유진의 볼이 붉어졌다. 첫 회의 때부터 손을 봤다는 게 어떻게 들리는지 뒤늦게 알아챈 모양이었다."
    y "얼굴은 다음에요. 얼굴 보면서 그리면 도현 씨가 저 보는 것도 보이잖아요."
    dn "오늘은 손까지만. 다음에 또 그려 달라고 해도 되려나."
    $ cream_focus = None
    return

label yujin_sp2:
    $ location = "일요일 밤 · 유진의 집"
    $ cream_focus = "yujin"
    $ cg("yujin_sp2")
    "음악이 끝나고, 유진이 노트북을 열었다. '창가' 계정의 비공개 폴더였다. 올리지 않은 그림이 서른 장쯤 있었다."
    "전부 뒷모습이었다. 어깨선, 손목시계, 창가에 앉은 실루엣. 전부 도현이었다."
    y "어제 올린 거, 미리 안 물어보고 올려서... 죄송해요. 리아 씨가 누구 닮았다고 하는 거 보고 무서웠어요. 도현 씨가 싫어할까 봐."
    d "싫진 않았어. 놀라긴 했지만."
    y "그래서 정했어요. 앞으로 도현 씨 나오는 그림은 올리기 전에 꼭 보여 드릴게요. 싫다고 하시면 안 올려요."
    "유진이 폴더를 도현 쪽으로 밀었다."
    y "이 중에 올려도 되는 거, 골라 주실래요? 하나도 없어도 괜찮아요."
    "도현은 한 장씩 넘겼다. 마지막 장에서 손이 멈췄다. 뒷모습이 아니라, 옆얼굴이었다. 반쯤 그리다 만."
    d "이건?"
    y "그건... 아직 아무한테도 안 보여 줄 거예요. 도현 씨한테도 원래 안 보여 주려고 했는데."
    dn "반쯤 남겨 둔 얼굴을 다시 보고 싶었지만, 유진 씨가 넘기기 전에는 페이지를 잡지 않았다."
    $ cream_focus = None
    return

# ── 서윤 ──────────────────────────────────────────────
label seoyun_sp1:
    $ location = "평일 밤 · 각자의 집, 전화"
    $ cream_focus = "seoyun"
    "밤 열두 시. 서윤에게서 전화가 왔다. 첫마디가 '안 자지?'였다."
    s "나 잠이 안 와. 책 읽어 줄래? 아니, 내가 읽어 줄게. 너 자면 끊을게."
    d "제가 먼저 자면 서운하지 않으세요?"
    s "서운하지. 근데 한번 해 보고 싶었어~ 내 목소리 듣다 잠드는 사람이 있으면 어떤가."
    $ cg("seoyun_sp1")
    "서윤이 『느린 모퉁이』를 펼치는 소리가 들렸다. 낮은 목소리로 한 문장씩, 쉼표마다 숨을 쉬며 읽었다."
    "농담할 때의 목소리와는 달랐다. 회의 때의 목소리와도 달랐다. 처음 듣는 목소리였다."
    "한쪽쯤 읽었을 때 서윤이 멈췄다."
    s "...자?"
    d "아직이요. 목소리 듣느라 못 자겠어요."
    s "그럼 실패네. 다음엔 더 지루한 책으로 가져올게."
    "그러고도 서윤은 끊지 않았다. 한 쪽을 더 읽었다. 도현은 두 번째 쪽 중간쯤에서 잠들었다. 다음 날 아침, 통화 시간이 한 시간 십이 분으로 찍혀 있었다."
    dn "책 읽던 데까지도 기억이 안 난다. 다음에 어느 줄에서 잠들었는지 물어봐야지."
    $ cream_focus = None
    return

label seoyun_sp2:
    $ location = "같은 일요일 밤 열한 시 · 서윤의 작업실"
    $ cream_focus = "seoyun"
    "메시지를 주고받고 한 시간 뒤, 서윤이 '잠이 안 와. 잠깐 올래?'라고 보냈다. 작업실에 들어서자마자 서윤이 자기 휴대폰을 도현 손에 쥐여 주었다."
    s "오늘 이거 네가 맡아 줘. 울려도 말해 주지 마. 누구한테 왔는지도."
    d "...무슨 일 있어요?"
    s "있는데, 오늘은 없는 걸로 하고 싶어. 내일부터 나흘 동안은 어차피 그쪽 시간이니까."
    "도현은 휴대폰을 주머니에 넣었다. 한 시간 동안 두 번 진동이 왔다. 도현은 꺼내 보지 않았다. 서윤도 묻지 않았다."
    $ cg("seoyun_sp2")
    "둘은 같이 서윤의 출장 짐을 쌌다. 서윤은 셔츠를 개는 동안 세 번 농담을 했고, 그중 두 번은 진짜로 웃겼다."
    "헤어질 때 도현이 휴대폰을 돌려주었다. 서윤은 화면을 켜지 않고 가방에 넣었다."
    s "고마워. 안 본 거, 알아. 그래서 맡긴 거야."
    d "다음에도 맡길 일 있으면 말하세요."
    s "...다음엔 네가 맡아 주는 대신 같이 보자고 하고 싶어. 언제쯤 그럴 수 있을진 모르겠다."
    dn "내 휴대폰이 울려도 한동안 꺼내 보기 싫었다. 셔츠 한 장 더 개고 돌아가야겠다."
    $ cream_focus = None
    return
