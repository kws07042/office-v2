# Final Ria story slots. Text-only; no new images or voice assets.

label ria_r13:
    $ progression_enter("ria_r13")
    $ progression_checkpoint("ria_r13")
    if not dating or active_route != "ria" or "ria_R12" not in completed or memory.get("ria_r12_next_appointment_status") != "scheduled":
        $ progression_note_ending()
        return
    $ chapter = "리아 R13 · 다음엔 더 재밌게라는 말"
    $ location = "같은 일요일 오후 세 시 사십오 분 · 약속 장소로 가는 길"
    "집을 나와 역을 지날 무렵 메시지가 왔다."
    call phone_deliver("ria_r13_01", "ria", ri('도현아, 미안. 정리가 아직 안 끝났어. 네 시에는 못 갈 것 같아. 오늘 조금 미루면 안 될까?', '도현 씨, 미안해요. 정리가 아직 안 끝났어요. 네 시에는 못 갈 것 같아요. 오늘 조금 미루면 안 될까요?'))
    call phone_deliver("ria_r13_02", "dohyun", ri('지금 나가는 길이야. 언제쯤 끝날 것 같아?', '지금 나가는 길이에요. 언제쯤 끝날 것 같아요?'))
    call phone_deliver("ria_r13_03", "ria", ri('아직 확실하지 않아. 늦어질 건 두 시쯤 알았는데, 어떻게든 맞춰 보려고 했어.', '아직 확실하지 않아요. 늦어질 건 두 시쯤 알았는데, 어떻게든 맞춰 보려고 했어요.'))
    if memory.get("ria_r12_expectation") == "hope_early":
        dn "오전에 만나자고 한 건 아니었다. 그래도 네 시엔 볼 줄 알았다. 기다리던 연락이 이런 내용이니 더 허전했다."
    else:
        dn "네 시에 맞추려고 일을 정리하고 나온 길이었다. 조금만 일찍 알았어도 집에서 마저 하고 나왔을 텐데."
    call phone_deliver("ria_r13_04", "dohyun", ri('끝나는 시각이 정해지면 알려 줘. 일단 역 근처 카페에 있을게.', '끝나는 시각이 정해지면 알려 주세요. 일단 역 근처 카페에 있을게요.'))
    $ remember("ria_r12_next_appointment_status", "changed_late_notice")
    $ remember("ria_r13_breach", "리아가 두 시에 지연을 알았지만 세 시 사십오 분에 연락")
    $ remember("ria_conflict", "open")
    $ location = "일요일 오후 네 시 반 · 개인 메시지"
    call phone_deliver("ria_r13_arrival", "ria", ri("다섯 시 십 분에는 도착할 수 있어. 그때까지 기다리는 거 괜찮을까?", "다섯 시 십 분에는 도착할 수 있어요. 그때까지 기다리시는 거 괜찮을까요?"))
    call phone_deliver("ria_r13_wait", "dohyun", ri("응. 그 시간까지 카페에 있을게. 와서 이야기하자.", "네. 그 시간까지 카페에 있을게요. 오시면 이야기해요."))
    $ location = "일요일 오후 다섯 시 십 분 · 역 근처 카페"
    "카페 문이 열리고 리아가 숨을 몰아쉬며 들어온다. 현장에서 왔다던 사람이, 구두에 정장 차림이었다."
    r "[ri('많이 기다렸지. 미안! 다음엔 진짜 재밌는 데 찾아 올게, 진짜로.', '많이 기다리셨죠. 미안해요! 다음엔 진짜 재밌는 곳 찾아 올게요, 진짜로요.')]"
    d "[ri('일단 앉아. 숨부터 돌리고.', '일단 앉으세요. 숨부터 돌리시고요.')]"
    "리아가 앉자마자 휴대폰을 꺼내 가게 검색부터 하려다, 멈칫한다."
    $ progression_enter("ria_r13.choice01")
    $ progression_checkpoint("ria_r13.choice01")
    menu:
        "서운했다고 솔직히 말한다.":
            $ remember("ria_r13_response", "honest")
            d "[ri('보고 싶어서 시간 비워 뒀는데, 나오는 길에 못 만난다는 연락 받으니까 속상하더라.', '보고 싶어서 시간 비워 뒀는데, 나오는 길에 못 만난다는 연락 받으니까 속상하더라고요.')]"
            d "[ri('다음 데이트가 재밌다고 풀릴 일은 아닌 것 같아.', '다음 데이트가 재밌다고 풀릴 일은 아닌 것 같아요.')]"
            r "[ri('...응. 늦을 것 같았을 때 바로 말했어야 했어. 너도 시간 정할 수 있게.', '...네. 늦을 것 같았을 때 바로 말했어야 했어요. 도현 씨도 시간 정할 수 있게요.')]"
        "두 시에 알았잖아, 하고 따진다.":
            $ remember("ria_r13_response", "ask")
            d "[ri('두 시에 알았으면 그때 말해 줄 수 있었잖아. 시간 맞추는 것보다 그게 먼저야.', '두 시에 알았으면 그때 말해 주실 수 있었잖아요. 시간 맞추는 것보다 그게 먼저예요.')]"
            r "[ri('맞아. 조금만 더 하면 된다는 생각만 하느라, 네가 벌써 나오고 있을 거란 걸 놓쳤어.', '맞아요. 조금만 더 하면 된다는 생각만 하느라, 벌써 나오고 계실 거란 걸 놓쳤어요.')]"
            d "[ri('기다릴지 다른 거 할지, 나도 고를 수 있게 해 줘.', '기다릴지 다른 거 할지, 저도 고를 수 있게 해 주세요.')]"
        "다음 데이트로 갚으라며 웃어넘긴다.":
            $ remember("ria_r13_response", "cover")
            d "[ri('그럼 다음엔 진짜 재밌어야 한다? 오늘 기다린 것까지 쳐서.', '그럼 다음엔 진짜 재밌어야 해요? 오늘 기다린 것까지 쳐서요.')]"
            "가볍게 던진 말이었는데, 리아는 검색 화면을 다시 켜지 않았다."
            r "[ri('...그 말대로 다음 데이트만 준비하면, 나 또 오늘처럼 너 기다리게 할 거야.', '...그 말대로 다음 데이트만 준비하면, 저 또 오늘처럼 기다리시게 할 거예요.')]"
            r "[ri('...안 속상했어? 그렇게 웃으면 내가 뭐부터 말해야 할지 모르겠잖아.', '...안 속상하셨어요? 그렇게 웃으시면 제가 뭐부터 말해야 할지 모르겠잖아요.')]"
    "리아가 휴대폰을 뒤집어 놓았다. 화면이 꺼지기 직전, 낯선 회사 이름이 박힌 메일 알림이 보였다."
    r "[ri('...현장 아니었어. 다른 회사 면접 보고 왔어. 두 시에 끝날 줄 알았는데 임원 면접까지 갔어.', '...현장 아니었어요. 다른 회사 면접 보고 왔어요. 두 시에 끝날 줄 알았는데 임원 면접까지 갔어요.')]"
    d "[ri('...면접? 피칭 앞두고?', '...면접이요? 피칭 앞두고요?')]"
    r "[ri('응. 몇 달 전부터 제안 받았어. 말하려고 했는데, 너랑 웃고 있으면 자꾸 다음으로 미루게 되더라.', '네. 몇 달 전부터 제안 받았어요. 말하려고 했는데, 도현 씨랑 웃고 있으면 자꾸 다음으로 미루게 되더라고요.')]"
    "도현은 아무 말도 하지 못했다. 리아도 이번엔 웃음으로 덮지 않았다."
    $ remember("ria_conflict", "discussing")
    $ award_once("ria_R13", "ria", 0, -1)
    $ progression_note_ending()
    return

label ria_r14:
    $ progression_enter("ria_r14")
    $ progression_checkpoint("ria_r14")
    if not dating or active_route != "ria" or "ria_R13" not in completed or memory.get("ria_conflict") != "discussing":
        $ progression_note_ending()
        return
    $ chapter = "리아 R14 · 시간을 지키는 연습"
    $ location = "같은 일요일 저녁 · 카페"
    if memory.get("ria_r13_response") == "cover":
        r "[ri('...변명 안 할게. 늦은 것도, 숨긴 것도 다 얘기할게.', '...변명 안 할게요. 늦은 것도, 숨긴 것도 다 얘기할게요.')]"
        $ progression_enter("ria_r14.choice01")
        $ progression_checkpoint("ria_r14.choice01")
        menu:
            "괜찮은 척했던 걸 털어놓는다.":
                $ remember("ria_r14_clarification", "feelings")
                d "[ri('솔직히 서운했어. 기다린 것보다, 네가 떠날 생각을 하고 있었다는 게. 괜찮다고 하는 게 편해서 그렇게 말한 거고.', '솔직히 서운했어요. 기다린 것보다, 떠날 생각을 하고 계셨다는 게요. 괜찮다고 하는 게 편해서 그렇게 말한 거고요.')]"
                r "[ri('...알아. 너 괜찮을 때는 괜찮다고 두 번 안 하거든. 그런데도 못 들은 척했어. 미안.', '...알아요. 도현 씨 괜찮을 때는 괜찮다고 두 번 안 하시거든요. 그런데도 못 들은 척했어요. 미안해요.')]"
            "보상 말고 연락이 필요하다고 고친다.":
                $ remember("ria_r14_clarification", "notice")
                d "[ri('아까 다음에 재밌으면 된다고 한 거, 취소. 큰일일수록 그때 바로 말해 줘. 그거면 돼.', '아까 다음에 재밌으면 된다고 한 거, 취소할게요. 큰일일수록 그때 바로 말해 주세요. 그거면 돼요.')]"
                r "[ri('...응. 확실해질 때까지 혼자 들고 있다가 말하는 거, 그거 내 나쁜 버릇이야. 고칠게.', '...네. 확실해질 때까지 혼자 들고 있다가 말하는 거, 그거 제 나쁜 버릇이에요. 고칠게요.')]"
            "나도 반칙이었다고 인정한다.":
                $ remember("choice_third_r14_clarification")
                $ remember("ria_r14_clarification", "both")
                d "[ri('나 사실 그때 안 괜찮았어. 근데 말도 안 해 놓고 네가 알아주길 바란 것도 반칙이지.', '저 사실 그때 안 괜찮았어요. 근데 말도 안 해 놓고 알아주시길 바란 것도 반칙이죠.')]"
                r "[ri('반칙은 반칙인데, 숨긴 건 나야. 그건 내가 잘못했어.', '반칙은 반칙인데, 숨긴 건 저예요. 그건 제가 잘못했어요.')]"
                d "[ri('그럼 무승부. 다음엔 난 서운하면 서운하다고 할게. 넌 혼자 정하기 전에 나한테 말해.', '그럼 무승부예요. 다음엔 저는 서운하면 서운하다고 할게요. 리아 씨는 혼자 정하기 전에 저한테 말해 주세요.')]"
        $ remember("ria_r14_understanding_confirmed")
    else:
        r "[ri('그러니까... 이직 얘기, 나 혼자 정하지 말라는 거지?', '그러니까... 이직 얘기, 저 혼자 정하지 말라는 거죠?')]"
        d "[ri('응. 가든 남든 네 일이야. 근데 내가 제일 마지막에 아는 사람은 싫어.', '네. 가든 남든 리아 씨 일이에요. 근데 제가 제일 마지막에 아는 사람은 싫어요.')]"
        $ remember("ria_r14_understanding_confirmed")
    "리아가 휴대폰을 끄고 가방에 넣었다. 답장하려던 그 회사 메일 창도 같이 꺼졌다."
    r "[ri('나는 이거 계속하고 싶어. 너랑. 그 회사엔... 아직 답 안 했어. 대답은 천천히 해도 돼. 표정 보니까 할 말 많아 보이거든.', '저는 이거 계속하고 싶어요. 도현 씨랑요. 그 회사엔... 아직 답 안 했어요. 대답은 천천히 하셔도 돼요. 표정 보니까 할 말 많아 보이거든요.')]"
    $ progression_enter("ria_r14.choice02")
    $ progression_checkpoint("ria_r14.choice02")
    menu:
        "같이 바꿔 보자고 한다 — 교제를 계속한다.":
            d "[ri('할 말 많은데, 결론은 하나야. 나도 계속할래.', '할 말 많은데, 결론은 하나예요. 저도 계속할래요.')]"
            $ remember("ria_r14_relationship_choice", "continue")
        "연애를 마치자고 한다 — 관계 종료 대화로 이어짐.":
            $ progression_enter("ria_r14.choice03")
            $ progression_checkpoint("ria_r14.choice03")
            menu:
                "연애를 마치겠다는 뜻을 확인한다.":
                    d "[ri('...얘기해 보니까 알겠어. 나 여기서 그만하고 싶어.', '...얘기해 보니까 알겠어요. 저 여기서 그만하고 싶어요.')]"
                    d "[ri('오늘 늦은 것 때문만은 아니야. 다음엔 또 뭘 숨길까, 그 생각부터 하게 될 것 같아.', '오늘 늦은 것 때문만은 아니에요. 다음엔 또 뭘 숨기실까, 그 생각부터 하게 될 것 같아요.')]"
                    r "[ri('......그렇구나. 응, 알겠어. 숨긴 건 진짜 미안해. 그건 네가 참아 줄 일이 아니었어.', '......그렇구나. 네, 알겠어요. 숨긴 건 진짜 미안해요. 그건 도현 씨가 참아 줄 일이 아니었어요.')]"
                    "카페를 나와 갈림길에서 멈춰 섰다. 리아가 손을 흔들고, 내일 회의 자료 얘기를 꺼냈다. 목소리가 평소보다 반 박자 빨랐다."
                    $ remember("ria_r14_relationship_choice", "end")
                    $ remember("ria_conflict", "closed_without_repair")
                    $ remember("ria_relationship_closed")
                    $ dating = False
                    $ ending = "ria_relationship_closed"
                    $ progression_note_ending()
                    return
                "끝내자는 말을 거둔다.":
                    d "[ri('끝내자는 말은 취소할게. 계속 만나고 싶어. 서운한 건 아직 좀 남았지만.', '끝내자는 말은 취소할게요. 계속 만나고 싶어요. 서운한 건 아직 좀 남았지만요.')]"
                    r "[ri('응. 그것까지 다 풀렸다고 혼자 정하진 않을게.', '네. 그것까지 다 풀렸다고 혼자 정하진 않을게요.')]"
                    $ remember("ria_r14_relationship_choice", "continue")
                    $ remember("ria_r14_rebuild_gradually")
                    $ remember("ria_r14_end_cancelled")
                "다음 약속을 보고 정하겠다고 한다.":
                    d "[ri('지금 당장 끝내자고는 안 할래. 다음에 만나서 내 마음 다시 말할게.', '지금 당장 끝내자고는 안 할래요. 다음에 만나서 제 마음 다시 말할게요.')]"
                    r "[ri('알겠어. 괜찮다는 대답 듣고 싶어서 조르지는 않을게.', '알겠어요. 괜찮다는 대답 듣고 싶어서 조르지는 않을게요.')]"
                    $ remember("ria_r14_relationship_choice", "continue")
                    $ remember("ria_r14_rebuild_gradually")
                    $ remember("ria_r14_end_pending")
        "계속 만나되, 다음 약속을 지켜보자고 한다.":
            $ remember("choice_third_r14_relationship")
            $ remember("ria_r14_relationship_choice", "continue")
            $ remember("ria_r14_rebuild_gradually")
            d "[ri('나도 계속 만나고 싶어. 근데 다 괜찮아졌다고 서두르진 말자.', '저도 계속 만나고 싶어요. 근데 다 괜찮아졌다고 서두르진 말아요.')]"
            r "[ri('응. 말로만 때우려는 거 아니야. 다음 약속부터 지킬게.', '네. 말로만 때우려는 거 아니에요. 다음 약속부터 지킬게요.')]"
    r "[ri('그 회사엔 피칭 끝날 때까지 답 미뤄 달라고 할게. 정하기 전에 너한테 제일 먼저 말하고.', '그 회사엔 피칭 끝날 때까지 답 미뤄 달라고 할게요. 정하기 전에 도현 씨한테 제일 먼저 말하고요.')]"
    r "[ri('다음 토요일은 어떤 방식으로 잡는 게 좋겠어?', '다음 토요일은 어떤 방식으로 잡는 게 좋겠어요?')]"
    $ progression_enter("ria_r14.choice04")
    $ progression_checkpoint("ria_r14.choice04")
    menu:
        "네 시부터 다섯 시 반까지만 보자고 한다.":
            $ remember("ria_r14_plan", "fixed")
            $ remember("ria_r14_appointment", "다음 토요일 오후 네 시, 다섯 시 반 귀가")
