            r "[ri('응. 다음엔 빈손으로 와. 내가 먼저 손 흔들 테니까~', '네. 다음엔 빈손으로 오세요. 제가 먼저 손 흔들 테니까요~')]"
            d "[ri('그럼 내가 먼저 보고 찾아낼게.', '그럼 제가 먼저 보고 찾아낼게요.')]"
        "서로의 일을 지키면서 오래 만나고 싶다고 말한다.":
            $ remember("ria_r16_vow", "our_own_time")
            d "[ri('네 현장 얘기도 계속 듣고 싶고, 내 노트도 아직 끝이 아니야. 천천히 오래 만나자.', '리아 씨 현장 얘기도 계속 듣고 싶고, 제 노트도 아직 끝이 아니에요. 천천히 오래 만나요.')]"
            r "[ri('응. 아무것도 안 한 날에도 네 얘긴 들려줘.', '네. 아무것도 안 한 날에도 도현 씨 얘긴 들려주세요.')]"
        "힘든 날에도 먼저 기대고 싶다고 말한다.":
            $ remember("choice_third_r16_vow")
            $ remember("ria_r16_vow", "ask_for_help")
            d "[ri('좋은 날만 보여 주려고 늦게 말하지 않을게. 힘든 날에도 네가 먼저 생각났으면 좋겠어.', '좋은 날만 보여 드리려고 늦게 말하지 않을게요. 힘든 날에도 리아 씨가 먼저 생각났으면 좋겠어요.')]"
            r "[ri('응. 나는 해결 못 해 줘도 옆에는 있을 수 있어.', '네. 저는 해결 못 해 드려도 옆에는 있을 수 있어요.')]"
            d "[ri('그럼 오늘부터. 디저트 다 먹고도 내 옆에 좀 있어 줘.', '그럼 오늘부터요. 디저트 다 먹고도 제 옆에 좀 있어 주세요.')]"
    "두 사람은 서로 다른 디저트를 골랐다. 리아는 도현의 것을 먼저 맛보고 자기 것을 한 입 건넸다. 도현이 접시를 당기자 이번에는 리아가 의자를 조금 더 가까이 끌었다."
    $ remember("ria_booklet_state", "rough_draft_shared")
    $ remember("ria_route_completed")
    $ award_once("ria_R16", "ria", 4)
    $ persistent.local_ria_ending = True
    $ ending = "ria_good"
    "리아 본편 결말 · 같이 쉬는 사람"
    return

label ria_e01:
    if not dating or active_route != "ria" or "ria_R16" not in completed or not memory.get("ria_route_completed") or memory.get("ria_conflict") != "resolved":
        return
    $ chapter = "리아 E01 · 아직 남은 지도"
    $ location = "약 반년 뒤, 겨울의 휴일 · 리아의 집"
    "겨울빛이 든 리아의 집. 도현은 사진과 글을 엮어 완성한 얇은 기록집 두 부를 가져왔다."
    d "[ri('다 만들었어. 오늘은 빈칸 없는 걸로 가져왔어.', '다 만들었어요. 오늘은 빈칸 없는 걸로 가져왔어요.')]"
    "도현이 한 부를 리아 쪽으로 밀었다. 리아는 바로 펼치지 않고 표지를 손바닥으로 한 번 쓸어 봤다."
    $ remember("ria_booklet_state", "completed_two_copies")
    r "[ri('첫 독자 몫은 여기? ...나 지금 좀 신나.', '첫 독자 몫은 여기예요? ...저 지금 좀 신나요.')]"
    d "[ri('응. 한 부는 네 거야. 나는 네가 먼저 뭐라고 할지 더 궁금해.', '네. 한 부는 리아 씨 거예요. 저는 먼저 뭐라고 하실지 더 궁금해요.')]"
    if memory.get("ria_o03_status") == "completed":
        if memory.get("ria_o03_rest") == "parallel":
            r "[ri('그때 각자 다른 거 보면서도 결국 네 옆에서 했잖아. 오늘도 여기 앉아.', '그때 각자 다른 거 보면서도 결국 도현 씨 옆에서 했잖아요. 오늘도 여기 앉아요.')]"
        elif memory.get("ria_o03_rest") == "share_page":
            r "[ri('그날 한 줄씩 보탰던 것도 있네. 오늘은 먼저 네 표정부터 볼래.', '그날 한 줄씩 보탰던 것도 있네요. 오늘은 먼저 도현 씨 표정부터 볼래요.')]"
        elif memory.get("ria_o03_rest") == "one_each":
            r "[ri('그날 한 가지씩만 보여 줬잖아. 오늘은 네가 먼저 하나 골라~', '그날 한 가지씩만 보여 줬잖아요. 오늘은 먼저 하나 골라 주세요~')]"
            d "[ri('네가 웃은 페이지. 아직 기억해.', '리아 씨가 웃으신 페이지요. 아직 기억해요.')]"
            $ remember("ria_e01_one_each_recalled")
    else:
        r "[ri('오늘은 잠깐만 볼래. 나머지는 네 옆에서 천천히 읽을 거야.', '오늘은 잠깐만 볼래요. 나머지는 도현 씨 옆에서 천천히 읽을 거예요.')]"
    if memory.get("ria_r15_future_plan") == "weekly_evening":
        "달력에는 같이 저녁 먹은 날의 작은 표시가 이어져 있었다. 날짜를 옮긴 주에는 새 칸에도 같은 표시가 있었다."
    else:
        "달력의 빈 주말 칸 옆에는 둘이 적은 약속이 있었다. 리아는 오늘 칸을 한 번 짚고 달력을 책 밑으로 밀었다."
    "리아는 첫 장에 작은 별 하나를 그리고 곧바로 책을 덮었다. 도현을 보며 외투를 들어 보였다."
    r "[ri('책은 이따 볼래. 우리 오늘 밖에 나갈까, 그냥 여기서 놀까?', '책은 이따 볼래요. 우리 오늘 밖에 나갈까요, 그냥 여기서 놀까요?')]"
    d "[ri('다음 산책길만 정하고, 오늘은 여기서 쉬자.', '다음 산책길만 정하고, 오늘은 여기서 쉬어요.')]"
    menu:
        "익숙한 곳을 다시 찾는 다음 산책을 제안한다.":
            $ remember("ria_e01_next_walk", "familiar")
            if memory.get("ria_o02_status") == "completed" and memory.get("ria_o02_name"):
                r "[ri('그때 이름 붙인 데? 우리끼리 부르던 이름으로 적어 둘게.', '그때 이름 붙인 곳이요? 우리끼리 부르던 이름으로 적어 둘게요.')]"
                "리아가 실제로 함께 붙였던 이름을 지도에서 짚었다."
                $ remember("ria_e01_recalled_place", memory["ria_o02_name"])
            else:
                d "[ri('다음엔 동네 공원부터 걸을까? 멀리 안 가고.', '다음엔 동네 공원부터 걸을까요? 멀리 안 가고요.')]"
                r "[ri('좋아. 앉을 자리 있으면 오래 앉아 있고~', '좋아요. 앉을 자리 있으면 오래 앉아 있고요~')]"
        "처음 가 보는 길을 다음에 하나만 찾아보자고 제안한다.":
            $ remember("ria_e01_next_walk", "new")
            d "[ri('다음엔 새 길 하나만 찾아보자. 그다음은 걸으면서 정하고.', '다음엔 새 길 하나만 찾아봐요. 그다음은 걸으면서 정하고요.')]"
            r "[ri('한 개만! 갑자기 코스 다섯 개로 늘리기 없기~', '한 개만! 갑자기 코스 다섯 개로 늘리기 없기~')]"
        "서로 한 곳씩 골라, 다음 산책 두 번을 느긋하게 약속한다.":
            $ remember("choice_third_e01_walk")
            $ remember("ria_e01_next_walk", "take_turns")
            d "[ri('다음엔 네가 한 곳, 그다음엔 내가 한 곳. 한 번에 다 가지는 말고.', '다음엔 리아 씨가 한 곳, 그다음엔 제가 한 곳이요. 한 번에 다 가지는 말고요.')]"
            r "[ri('좋아. 다음 약속이 두 개네~ 지도 다 채우는 건 더 늦어지겠다.', '좋아요. 다음 약속이 두 개네요~ 지도 다 채우는 건 더 늦어지겠어요.')]"
            d "[ri('천천히 채우려고 만든 거니까.', '천천히 채우려고 만든 거니까요.')]"
    "다음 산책 후보를 표시하고 지도를 접었다. 오늘은 집에서 늦은 점심을 같이 만들기로 했다."
    "리아가 냉장고 앞에서 재료 둘을 들고 돌아봤다."
    r "[ri('오늘은 네가 골라. 지난번엔 내가 메뉴 정했잖아.', '오늘은 도현 씨가 골라 주세요. 지난번엔 제가 메뉴 정했잖아요.')]"
    d "[ri('그럼 내가 고르고 네가 맛봐. 공평하지?', '그럼 제가 고르고 리아 씨가 맛봐 주세요. 공평하죠?')]"
    r "[ri('그건 내가 심사위원이란 소리네~ 좋아!', '그건 제가 심사위원이란 소리네요~ 좋아요!')]"
    if memory.get("ria_r15_outfit") == "cosplay":
        r "[ri('전에 같이 고른 옷, 오늘 다시 입어 볼까?', '전에 같이 고른 옷, 오늘 다시 입어 볼까요?')]"
        d "[ri('문 앞에서 웃던 네 얼굴도 좋은데, 지금 소매 걷고 요리하는 모습은 더 좋아.', '문 앞에서 웃던 리아 씨 얼굴도 좋은데요, 지금 소매 걷고 요리하는 모습은 더 좋아요.')]"
    "점심을 먹으며 서로의 접시를 한 입씩 바꿨다. 리아는 맛을 평가하다가 도현의 웃는 얼굴을 보고 말을 잠깐 잃었다. 약속한 시각에 도현이 돌아갈 준비를 했다. 리아는 현관까지 배웅한 뒤 문 앞에서 손을 흔들었다."
    $ location = "겨울의 휴일 저녁 · 각자의 집"
    $ remember("ria_epilogue_completed")
    $ award_once("ria_E01", "ria", 8)
    "리아 후일담 · 아직 남은 지도"
    return
