# Final Ria story slots. Text-only; no new images or voice assets.

label ria_r13:
    if not dating or active_route != "ria" or "ria_R12" not in completed or memory.get("ria_r12_next_appointment_status") != "scheduled":
        return
    $ chapter = "리아 R13 · 다음엔 더 재밌게라는 말"
    $ location = "같은 일요일 오후 세 시 사십오 분 · 약속 장소로 가는 길"
    "집을 나와 역을 지날 무렵 메시지가 왔다."
    msgr "[ri('도현아, 미안. 정리가 아직 안 끝났어. 네 시에는 못 갈 것 같아. 오늘 조금 미루면 안 될까?', '도현 씨, 미안해요. 정리가 아직 안 끝났어요. 네 시에는 못 갈 것 같아요. 오늘 조금 미루면 안 될까요?')]"
    msgd "[ri('지금 나가는 길이야. 언제쯤 끝날 것 같아?', '지금 나가는 길이에요. 언제쯤 끝날 것 같아요?')]"
    msgr "[ri('아직 확실하지 않아. 늦어질 건 두 시쯤 알았는데, 어떻게든 맞춰 보려고 했어.', '아직 확실하지 않아요. 늦어질 건 두 시쯤 알았는데, 어떻게든 맞춰 보려고 했어요.')]"
    if memory.get("ria_r12_expectation") == "hope_early":
        dn "오전에 만나자는 약속을 한 건 아니었다. 그래도 네 시에는 볼 줄 알았다. 기다리던 연락이 이렇게 오니 더 허전했다."
    else:
        dn "네 시에 맞춰 일을 정리하고 나온 길이었다. 조금 전에 알았으면 집에서 마저 하고 나왔을 텐데."
    msgd "[ri('끝나는 시각이 정해지면 알려 줘. 일단 역 근처 카페에 있을게.', '끝나는 시각이 정해지면 알려 주세요. 일단 역 근처 카페에 있을게요.')]"
    $ remember("ria_r12_next_appointment_status", "changed_late_notice")
    $ remember("ria_r13_breach", "리아가 두 시에 지연을 알았지만 세 시 사십오 분에 연락")
    $ remember("ria_conflict", "open")
    $ location = "일요일 오후 다섯 시 십 분 · 역 근처 카페"
    "네 시 반에 다섯 시 십 분이면 도착할 수 있다는 연락이 왔다. 도현은 그 시간까지 기다리겠다고 답했다. 리아가 문을 열고 들어온다."
    r "[ri('많이 기다렸지. 미안. 다음에는 내가 진짜 재밌는 데 찾아 올게.', '많이 기다리셨죠. 미안해요. 다음에는 제가 진짜 재밌는 곳 찾아 올게요.')]"
    d "[ri('일단 앉아. 숨부터 돌리고.', '일단 앉으세요. 숨부터 돌리시고요.')]"
    "리아는 가방에서 휴대폰을 꺼내 새 가게를 검색하려다 멈춘다."
    menu:
        "기다리며 속상했던 마음과 늦은 연락을 솔직히 말한다.":
            $ remember("ria_r13_response", "honest")
            d "[ri('보고 싶어서 시간을 비워 뒀는데, 나오는 중에야 못 만난다고 하니까 속상했어.', '보고 싶어서 시간을 비워 뒀는데, 나오는 중에야 못 만난다고 하시니까 속상했어요.')]"
            d "[ri('다음 장소가 재밌으면 괜찮아지는 문제는 아닌 것 같아.', '다음 장소가 재밌으면 괜찮아지는 문제는 아닌 것 같아요.')]"
            r "[ri('응. 늦어질 걸 알았을 때 말했어야 했어. 네 시간도 정할 수 있게.', '네. 늦어질 걸 알았을 때 말했어야 했어요. 도현 씨 시간도 정할 수 있게요.')]"
        "늦어질 것을 알았을 때 연락하기로 한 약속을 짚는다.":
            $ remember("ria_r13_response", "ask")
            d "[ri('두 시에 알았으면 그때 말해 줄 수 있었잖아. 시간 맞추는 것보다 그게 먼저였어.', '두 시에 알았으면 그때 말해 주실 수 있었잖아요. 시간 맞추는 것보다 그게 먼저였어요.')]"
            r "[ri('그랬어야 했어. 조금만 더 하면 된다고 생각하느라 네가 이미 준비하고 있을 걸 놓쳤어.', '그랬어야 했어요. 조금만 더 하면 된다고 생각하느라 이미 준비하고 계실 걸 놓쳤어요.')]"
            d "[ri('내가 기다릴지, 다른 일을 할지 고를 수 있게 먼저 알려 줘.', '제가 기다릴지, 다른 일을 할지 고를 수 있게 먼저 알려 주세요.')]"
        "속상하지만 다음에 즐거운 데이트로 보상해 달라며 넘긴다.":
            $ remember("ria_r13_response", "cover")
            d "[ri('그럼 다음에는 진짜 재밌어야겠다. 오늘 기다린 것까지.', '그럼 다음에는 진짜 재밌어야겠네요. 오늘 기다린 것까지요.')]"
            "말은 가볍게 나왔지만 리아는 검색 화면을 켜지 않았다."
            r "[ri('...그 말대로 다음 데이트만 준비하면 오늘처럼 또 기다리게 할 것 같아.', '...그 말대로 다음 데이트만 준비하면 오늘처럼 또 기다리게 할 것 같아요.')]"
            r "[ri('네가 안 속상한 건 아닌 것 같은데. 내가 어떻게 바꿔야 하는지도 얘기하고 싶어.', '안 속상하신 건 아닌 것 같은데요. 제가 어떻게 바꿔야 하는지도 얘기하고 싶어요.')]"
    r "[ri('잠깐 맡겨도 되는 확인까지 내가 끝내려고 했어. 만나기로 해 놓고도.', '잠깐 맡겨도 되는 확인까지 제가 끝내려고 했어요. 만나기로 해 놓고도요.')]"
    d "[ri('나도 네가 무리해서 뛰어오는 걸 원한 건 아니야.', '저도 무리해서 뛰어오시는 걸 원한 건 아니에요.')]"
    r "[ri('알아. 바빠진 걸 없앨 수는 없어도, 알고도 말 안 한 건 바꿀 수 있어.', '알아요. 바빠진 걸 없앨 수는 없어도, 알고도 말 안 한 건 바꿀 수 있어요.')]"
    "새 가게 목록 대신 비어 있는 다음 토요일 칸을 함께 본다. 오늘의 사과와 다음 약속은 아직 다른 일이었다."
    $ remember("ria_conflict", "discussing")
    $ award_once("ria_R13", "ria", 0, -1)
    return

label ria_r14:
    if not dating or active_route != "ria" or "ria_R13" not in completed or memory.get("ria_conflict") != "discussing":
        return
    $ chapter = "리아 R14 · 시간을 지키는 연습"
    $ location = "같은 일요일 저녁 · 카페"
    if memory.get("ria_r13_response") == "cover":
        r "[ri('다음 장소 말고, 오늘 네가 기다린 얘기를 먼저 해도 될까?', '다음 장소 말고, 오늘 기다리신 얘기를 먼저 해도 될까요?')]"
        menu:
            "괜찮은 척했지만 기다리는 시간이 아쉬웠다고 말한다.":
                $ remember("ria_r14_clarification", "feelings")
                d "[ri('속상했어. 오늘 보려고 비운 시간이라. 괜찮다고 넘기는 게 더 쉬워서 그랬어.', '속상했어요. 오늘 보려고 비운 시간이라서요. 괜찮다고 넘기는 게 더 쉬워서 그랬어요.')]"
                r "[ri('말해 줘서 고마워. 네가 더 이해해 줘야 한다고 생각하고 싶진 않아.', '말해 주셔서 고마워요. 더 이해해 주셔야 한다고 생각하고 싶진 않아요.')]"
            "즐거운 보상보다 먼저 변경 연락이 필요하다고 정정한다.":
                $ remember("ria_r14_clarification", "notice")
                d "[ri('다음에 재밌으면 된다는 말은 취소. 늦어질 걸 알았을 때 먼저 말해 줬으면 좋겠어.', '다음에 재밌으면 된다는 말은 취소할게요. 늦어질 걸 알았을 때 먼저 말해 주셨으면 좋겠어요.')]"
                r "[ri('응. 일정을 바꿀 수 있게, 확실히 끝날 때까지 기다리지 않고.', '네. 일정을 바꿀 수 있게, 확실히 끝날 때까지 기다리지 않고요.')]"
            "괜찮은 척했던 내 대답을 고치고, 앞으로 필요한 연락을 함께 정한다.":
                $ remember("choice_third_r14_clarification")
                $ remember("ria_r14_clarification", "both")
                d "[ri('괜찮다고 넘긴 건 내 마음과 달랐어. 그래도 네가 알아맞히길 바라면 안 되겠지.', '괜찮다고 넘긴 건 제 마음과 달랐어요. 그래도 알아맞혀 주시길 바라면 안 되겠죠.')]"
                r "[ri('네가 돌려 말했어도, 내가 연락을 늦게 한 건 내 잘못이야.', '돌려 말씀하셨어도, 제가 연락을 늦게 한 건 제 잘못이에요.')]"
                d "[ri('응. 다음엔 난 기다리기 어렵다고 말할게. 넌 바뀔 것 같으면 먼저 알려 줘.', '네. 다음엔 저는 기다리기 어렵다고 말할게요. 리아 씨는 바뀔 것 같으면 먼저 알려 주세요.')]"
        $ remember("ria_r14_understanding_confirmed")
    else:
        r "[ri('오늘 네가 말한 건, 내가 더 멋진 데를 준비하라는 뜻은 아니지.', '오늘 말씀하신 건, 제가 더 멋진 곳을 준비하라는 뜻은 아니죠.')]"
        d "[ri('응. 우리가 쓸 시간을 같이 정하고 싶다는 얘기야.', '네. 우리가 쓸 시간을 같이 정하고 싶다는 얘기예요.')]"
        $ remember("ria_r14_understanding_confirmed")
    r "[ri('내가 맡기지 못했던 정리부터 나눌게. 약속도 끝낼 수 있는 시간으로 잡고.', '제가 맡기지 못했던 정리부터 나눌게요. 약속도 끝낼 수 있는 시간으로 잡고요.')]"
    menu:
        "함께 바꿔 보자고 말한다 — 교제를 계속한다.":
            d "[ri('나도 계속 만나고 싶어. 다음에는 그렇게 해 보자.', '저도 계속 만나고 싶어요. 다음에는 그렇게 해 봐요.')]"
            $ remember("ria_r14_relationship_choice", "continue")
        "연애를 마치고 싶다고 분명히 말한다 — 관계 종료 대화로 이어짐.":
            d "[ri('얘기해 봤지만 나는 여기서 연애를 마치고 싶어.', '얘기해 봤지만 저는 여기서 연애를 마치고 싶어요.')]"
            r "[ri('...알겠어. 오늘 늦게 말한 일은 미안해. 그건 네가 이해해 줘야 할 일이 아니었어.', '...알겠어요. 오늘 늦게 말한 일은 미안해요. 그건 이해해 주셔야 할 일이 아니었어요.')]"
            "두 사람은 앞으로 회사에서는 협업에 필요한 이야기를 하기로 했다. 다음 연인 약속은 잡지 않았다."
            $ remember("ria_r14_relationship_choice", "end")
            $ remember("ria_conflict", "closed_without_repair")
            $ remember("ria_relationship_closed")
            $ dating = False
            $ ending = "ria_relationship_closed"
            return
        "교제는 계속하되, 다음 약속에서 달라진 행동을 함께 확인한다.":
            $ remember("choice_third_r14_relationship")
            $ remember("ria_r14_relationship_choice", "continue")
            $ remember("ria_r14_rebuild_gradually")
            d "[ri('나도 계속 만나고 싶어. 다 괜찮아졌다고 서두르지는 말자.', '저도 계속 만나고 싶어요. 다 괜찮아졌다고 서두르지는 말아요.')]"
            r "[ri('응. 지금 말만 잘해서 끝내려는 건 아니야. 다음 약속부터 지킬게.', '네. 지금 말만 잘해서 끝내려는 건 아니에요. 다음 약속부터 지킬게요.')]"
    r "[ri('다음 토요일은 어떤 방식으로 잡는 게 좋겠어?', '다음 토요일은 어떤 방식으로 잡는 게 좋겠어요?')]"
    menu:
        "네 시부터 다섯 시 반까지, 짧고 확실한 만남을 정한다.":
            $ remember("ria_r14_plan", "fixed")
            $ remember("ria_r14_appointment", "다음 토요일 오후 네 시, 다섯 시 반 귀가")
            d "[ri('나는 네 시부터 다섯 시 반까지면 좋아. 그 뒤에는 내 일도 마저 하고.', '저는 네 시부터 다섯 시 반까지면 좋아요. 그 뒤에는 제 일도 마저 하고요.')]"
            r "[ri('좋아. 길게 있어야 잘 만나는 건 아니니까.', '좋아요. 길게 있어야 잘 만나는 건 아니니까요.')]"
        "토요일 오후 시간을 비워 두기 전에 금요일에 시각을 함께 확정한다.":
            $ remember("ria_r14_plan", "confirm")
            $ remember("ria_r14_appointment", "금요일 확인 뒤 토요일 오후 만남 확정")
            d "[ri('금요일에 끝낼 수 있는 시각부터 확인하자. 그전에는 토요일 오후를 다 비워 두지는 않을게.', '금요일에 끝낼 수 있는 시각부터 확인해요. 그전에는 토요일 오후를 다 비워 두지는 않을게요.')]"
            r "[ri('응. 기다려 달라는 약속부터 잡지 않을게.', '네. 기다려 달라는 약속부터 잡지 않을게요.')]"
        "네 시 약속은 지키고, 코스 없이 한곳에서 쉬자고 정한다.":
            $ remember("choice_third_r14_plan")
            $ remember("ria_r14_plan", "fixed")
            $ remember("ria_r14_appointment", "다음 토요일 오후 네 시, 다섯 시 반 귀가")
            $ remember("ria_r14_quiet_plan")
            d "[ri('시간은 네 시부터 다섯 시 반까지. 오늘은 옮겨 다니지 않고 한곳에 있자.', '시간은 네 시부터 다섯 시 반까지요. 오늘은 옮겨 다니지 않고 한곳에 있어요.')]"
            r "[ri('좋아. 멋진 계획보다 제시간에 만나서 쉬는 걸로.', '좋아요. 멋진 계획보다 제시간에 만나서 쉬는 걸로요.')]"
    r "[ri('변경될 것 같으면 알게 된 때 말할게. 네가 이미 나와 있을 때 말고.', '변경될 것 같으면 알게 된 때 말할게요. 이미 나와 계실 때 말고요.')]"
    $ remember("ria_r14_notice_agreed", "지연 가능성을 알면 즉시 알리고 변경 시각은 함께 확인")
    $ remember("ria_conflict", "agreed")
    $ location = "다음 주 평일 · 온빛브랜딩"
    "리아는 현장 확인 목록을 담당 범위별로 나눴다. 다음 운영의 일차 정리는 현장 담당자가 맡고, 리아는 마지막 검토 시각을 정해 두었다."
    r "일차 확인은 이 목록대로 부탁드릴게요. 저는 세 시까지 보고 추가로 필요한 것만 전달하겠습니다."
    $ remember("ria_r14_delegation_done")
    $ location = "금요일 오후 · 개인 메시지"
    if memory.get("ria_r14_plan") == "fixed":
        msgr "[ri('내일 오전 정리는 담당자가 맡았어. 오후 확인도 오늘 끝냈고. 네 시 약속 그대로 보자!', '내일 오전 정리는 담당자가 맡았어요. 오후 확인도 오늘 끝냈고요. 네 시 약속 그대로 봐요!')]"
        msgd "[ri('좋아. 네 시에. 나는 노트 들고 갈게~', '좋아요. 네 시에요. 저는 노트 들고 갈게요~')]"
        $ location = "토요일 오후 세 시 오십 분 · 약속한 카페"
