    $ remember("ria_r16_work_result", "리아가 현장 판단 근거를 설명하고 다음 운영 검증을 맡음")
    $ location = "금요일 퇴근 후 · 동네 카페"
    r "[ri('오늘은 분위기 담당 말고, 진짜 담당자로 끝냈다!', '오늘은 분위기 담당 말고, 진짜 담당자로 끝냈어요!')]"
    if memory.get("ria_r09_support") == "explain":
        d "[ri('그때 네가 직접 설명한 두 사진부터 이어진 거네.', '그때 직접 설명하신 두 사진부터 이어진 거네요.')]"
    elif memory.get("ria_r09_support") == "organize":
        d "[ri('그때 같이 정리했던 한 장도 남았네. 네 이름이랑 같이.', '그때 같이 정리했던 한 장도 남았네요. 리아 씨 이름이랑 같이요.')]"
