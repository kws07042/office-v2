        return
    $ chapter = "서윤 R11 · 다음 주의 일정"
    $ location = "목요일 오전 · 탕비실"
    r "[ri('도현아, 서윤 언니 요즘 전화 받으러 자꾸 나가는 거 알아?', '도현 씨, 서윤 언니 요즘 전화 받으러 자꾸 나가는 거 알아요?')]"
    d "[ri('클라이언트 전화겠지.', '클라이언트 전화겠죠.')]"
    r "[ri('클라이언트 전화를 비상계단에서 받아? 그리고 돌아올 때 표정이... 언니 그런 표정 처음 봤어.', '클라이언트 전화를 비상계단에서 받아요? 그리고 돌아올 때 표정이... 언니 그런 표정 처음 봤어요.')]"
    "리아가 종이컵을 구기며 목소리를 낮췄다."
