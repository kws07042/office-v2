# Six planned work-style mini-scenes. No affinity or relationship gates.
default work_style = None

init python:
    WORK_MINI_IDS = {
        "verify": ("W_VERIFY01", "W_VERIFY02"),
        "coordinate": ("W_COORD01", "W_COORD02"),
        "try": ("W_TEST01", "W_TEST02"),
    }

    def work_mini_id(style, stage):
        if style not in WORK_MINI_IDS or stage not in (1, 2):
            return None
        return WORK_MINI_IDS[style][stage - 1]

label work_mini_first:
    $ progression_enter("work_mini_first")
    $ progression_checkpoint("work_mini_first")
    if work_style not in WORK_MINI_IDS:
        $ work_style = c07_method if c07_method in WORK_MINI_IDS else None
    if work_style is None or memory.get("work_stage_1"):
        $ progression_note_ending()
        return
    if work_style == "verify":
        call work_verify01
    elif work_style == "coordinate":
        call work_coord01
    else:
        call work_test01
    $ remember("work_stage_1", work_mini_id(work_style, 1))
    call work_mini_coda(1)
    $ progression_note_ending()
    return

label work_mini_second:
    $ progression_enter("work_mini_second")
    $ progression_checkpoint("work_mini_second")
    if work_style not in WORK_MINI_IDS:
        $ work_style = c07_method if c07_method in WORK_MINI_IDS else None
    if work_style is None or memory.get("work_stage_2"):
        $ progression_note_ending()
        return
    if work_style == "verify":
        call work_verify02
    elif work_style == "coordinate":
        call work_coord02
    else:
        call work_test02
    $ remember("work_stage_2", work_mini_id(work_style, 2))
    call work_mini_coda(2)
    $ progression_note_ending()
    return

label work_mini_coda(stage):
    $ progression_enter("work_mini_coda")
    $ progression_checkpoint("work_mini_coda")
    # Public collaboration never reveals the selected private relationship.
    if active_route == "colleague" or active_route not in affinity:
        $ progression_note_ending()
        return
    if stage == 1:
        $ location = "같은 날 퇴근 전 · 복도"
        "자료를 돌려놓고 나오자, 복도에서 잠깐 둘만 걸음이 나란해졌다."
        if active_route == "ria":
            r "[ri('아까 말 잘하던데~ 다음에 만날 때도 그렇게 준비해 올 거야?', '아까 말씀 잘하시던데요~ 다음에 만날 때도 그렇게 준비해 오실 거예요?')]"
            d "[ri('질문은 하나쯤. 대답까지 써 가면 재미없잖아.', '질문은 하나쯤요. 대답까지 써 가면 재미없잖아요.')]"
            r "[ri('좋아. 나도 답은 아직 안 정할래!', '좋아요. 저도 답은 아직 안 정할래요!')]"
        elif active_route == "jihyun":
            j "오늘은 내가 질문할 틈이 별로 없었네."
            d "다음에 따로 뵐 때 쓰세요. 저도 물어보고 싶은 게 있어서요."
            j "업무 말고?"
            d "네. 그쪽이 더 궁금해졌어요."
            "지현이 펜을 셔츠 주머니에 넣는다."
            j "그럼 이건 두고 가야겠네."
        elif active_route == "yujin":
            y "아까는 제 말을 끝까지 기다려 주셔서 좋았어요."
            d "다음에 같이 볼 때도 먼저 설명하실 건가요?"
            y "아뇨. 그때는 도현 씨가 어디서 멈추는지 보고 싶어요."
            d "유진 씨 앞에서 오래 멈추면요?"
            y "...그건 제가 설명할 일이 아닌데요~"
        else:
            s "회의에선 대답 잘하던데. 내 질문에도 그럴까?"
            d "모르는 건 모른다고 할게요. 대신 다시 물으러 오고요."
            s "그럼 내가 일부러 어려운 걸 골라야겠네~"
            d "자주 오라는 뜻으로 들을게요."
            "서윤은 먼저 웃었지만, 대답은 엘리베이터 문이 열릴 때까지 미뤘다."
    elif dating:
        $ location = "같은 날 업무를 마친 뒤 · 엘리베이터 안"
        "다른 동료들이 먼저 내려간 뒤, 둘만 남아 다음 엘리베이터에 탔다."
        if active_route == "ria":
            r "[ri('아까는 업무 얘기라 참았어. 좀 멋있었거든.', '아까는 업무 얘기라 참았어요. 조금 멋있었거든요.')]"
            d "[ri('그럼 지금은 안 참아도 되네.', '그럼 지금은 안 참으셔도 되네요.')]"
            r "[ri('이미 말했잖아! 두 번 들으려고 그러지~', '이미 말했잖아요! 두 번 들으려고 그러시죠~')]"
        elif active_route == "jihyun":
            j "아까는 내가 말 끊을 뻔했어. 끝까지 듣길 잘했네."
            d "이번엔 칭찬으로 들을게요."
            j "맞아. 오늘은 그렇게 들어."
            "도현이 대답 대신 웃자 지현이 닫힘 버튼에서 손을 뗐다."
            j "...뭐야. 말로 받던 사람이."
            d "좋아서요. 조금 더 듣고 싶어질까 봐."
        elif active_route == "yujin":
            y "회의 끝났으니까 하나만 물어봐도 돼요?"
            d "네. 이쪽도 채점하시게요?"
            y "아뇨. 오늘 제 쪽 보시고 웃으신 건... 저 때문에 맞죠?"
            d "그건 다시 확인 안 하셔도 돼요."
            y "알아요. 그래도 직접 듣는 건 좋네요~"
        else:
            s "일 끝났네. 이제 나 보고 웃어도 돼."
            d "아까도 서윤 씨 보고 웃었는데요."
            s "그건 내가 말한 게 웃겨서잖아."
            d "지금은 보고 있어서요."
            "서윤이 누르려던 층을 한 번 더 살핀다."
            s "...알았어. 엘리베이터 잘못 타게 하진 말고~"
    $ progression_note_ending()
    return

label work_verify01:
    $ progression_enter("work_verify01")
    $ progression_checkpoint("work_verify01")
    if memory.get("work_verify01_complete"):
        $ progression_note_ending()
        return
    $ chapter = "W_VERIFY01 · 표의 작은 빈칸"
    $ location = "다음 만남을 앞둔 평일 오후 · 회의 공간"
    "새 시안 옆에 비교표 한 장이 놓였다. 지현이 오른쪽 숫자에 동그라미를 그리자 리아가 의자를 끌어당겼다."
    j "이쪽 반응이 더 좋네. 조건이 같으면 이 안부터 보면 되겠어."
    r "[ri('큰 숫자 쪽? 오늘 회의 빨리 끝나겠다~', '큰 숫자 쪽이요? 오늘 회의 빨리 끝나겠네요~')]"
    "도현은 표를 한 줄 내려 읽다가 멈췄다. 조사 시각이 들어갈 칸이 비어 있었다."
    d "잠깐만요. 큰 숫자는 주말이고, 이쪽은 평일인가요?"
    j "원본에는 적혀 있을 텐데. 내가 옮기면서 빼먹었나."
    "지현이 자료를 다시 펼친다. 리아는 벌써 밀어 뒀던 의자를 도로 당겼다."
    r "[ri('방금 내 퇴근 희망도 같이 당겨졌어.', '방금 제 퇴근 희망도 같이 당겨졌어요.')]"
    d "[ri('의자는 아직 여기 있었어. 희망만 먼저 갔네.', '의자는 아직 여기 있었어요. 희망만 먼저 갔네요.')]"
    "유진은 시안 위에 얹었던 손을 거뒀다."
    y "그럼 색 때문에 더 좋았다는 것도 아직 모르는 거네요?"
    d "네. 그림이 진 건 아닌 것 같아요. 서로 다른 날에 뛰었을 수도 있어서요."
    j "좋아. 지금 확인할 것 하나만 먼저 정하자."
    $ progression_enter("work_verify01.choice01")
    $ progression_checkpoint("work_verify01.choice01")
    menu:
        "두 자료의 조사 시간부터 나란히 적는다.":
            $ remember("work_verify01_choice", "conditions")
            "원본의 요일과 시간대를 표 아래에 나란히 적었다. 한쪽은 주말 낮, 다른 쪽은 평일 오전이었다."
            d "숫자는 맞아요. 같은 조건이라는 설명만 빼면 될 것 같아요."
            j "응. 이 두 줄이 먼저였네."
            r "[ri('그럼 큰 숫자 보고 들뜬 나도 다시 앉아야겠네.', '그럼 큰 숫자 보고 들뜬 저도 다시 앉아야겠네요.')]"
            d "[ri('아직 안 일어났잖아.', '아직 안 일어나셨잖아요.')]"
            r "[ri('일어날 뻔했다고~', '일어날 뻔했다고요~')]"
        "자료를 모은 담당자에게 물어볼 질문을 적는다.":
            $ remember("work_verify01_choice", "question")
            d "요일하고 시각이 같았는지, 두 가지만 먼저 물어볼게요."
            y "어느 안이 더 좋았냐고부터 묻지는 않는 거네요."
            d "그 답을 먼저 들으면 저도 큰 숫자 편을 들 것 같아서요."
            "담당자에게 확인한 결과, 시간대가 달랐다. 지현이 질문 옆에 답을 짧게 적는다."
            j "물음표 두 개가 회의 한 번 줄였네."
            r "[ri('도현아, 내일 질문은 두 개까지만 해.', '도현 씨, 내일 질문은 두 개까지만 해 주세요.')]"
            d "[ri('방금은 회의 줄여 줬는데?', '방금은 회의 줄여 드렸는데요?')]"
        "원본을 함께 펴고 비어 있는 칸을 확인한다.":
            $ remember("work_verify01_choice", "original")
            "지현과 원본을 한 장씩 잡았다. 두 번째 장 아래에 붙어 있던 시간표가 떨어지며 리아 쪽으로 미끄러졌다."
            r "[ri('범인 확보!', '범인 확보했어요!')]"
            j "내가 뒤에 붙여 놨네. 앞장만 보고 비교했어."
            d "저도 처음엔 숫자부터 봤어요. 이건 앞에 같이 놓죠."
            "지현은 빠진 시간표를 비교표 옆에 붙였다."
            j "다음엔 원본한테 숨바꼭질할 자리 안 줘야겠다."
    "유진은 두 시안을 버리지 않고 각각의 조사 조건 아래에 놓았다."
    y "다시 볼 때는 같은 시간에 놓고 확인해 볼게요. 둘 다 아직 후보인 거죠?"
    j "응. 오늘은 승자 없이 끝."
    s "대신 잃어버린 건 찾았네~"
    d "빠진 조건 말고 또요?"
    s "리아 씨 퇴근 희망. 이번엔 의자 밑에 두고 가지 말라고."
    r "[ri('그건 내가 직접 챙길게!', '그건 제가 직접 챙길게요!')]"
    "유진이 두 시안을 다시 포갰다. 이번에는 비교표 옆에 조사 조건도 함께 남겨 뒀다."
    $ remember("work_verify01_complete")
