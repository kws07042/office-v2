        "오늘은 밤을 보내기보다, 잠깐 더 앉아 서로의 마음을 이야기한다.":
            $ remember("choice_third_r07_pace")
            d "[ri('나도 가까워지고 싶어. 오늘은 그 마음부터 조금 더 말하고 싶어.', '저도 가까워지고 싶어요. 오늘은 그 마음부터 조금 더 말하고 싶어요.')]"
            r "[ri('응. 밤을 같이 보내야만 할 수 있는 얘기는 아니니까.', '네. 밤을 같이 보내야만 할 수 있는 얘기는 아니니까요.')]"
            r "[ri('오늘 예쁘다고 하면, 원래 예뻤는데? 이렇게 받으려고 했거든.', '오늘 예쁘다고 하시면, 원래 예뻤는데요? 이렇게 받으려고 했거든요.')]"
            d "[ri('오늘 예쁘다.', '오늘 예쁘세요.')]"
            r "[ri('...지금 하면 어떻게 해!', '...지금 하시면 어떻게 해요!')]"
            d "[ri('연습 도와준 건데. 난 고백할 말 외우다가 네 이름부터 까먹을 뻔했어.', '연습 도와드린 건데요. 저는 고백할 말 외우다가 리아 씨 이름부터 까먹을 뻔했어요.')]"
            "리아가 웃다가 다 식은 차를 마셨다. 도현은 돌아갈 버스 시각을 확인한 뒤 일어났다."
            $ remember("ria_r07_intimacy", "deferred")
            $ remember("ria_r07_feelings_shared")
    $ award_once("ria_R07", "ria", 0)
    $ progression_note_ending()
    return

label ria_r08:
    $ progression_enter("ria_r08")
    $ progression_checkpoint("ria_r08")
    if not dating or active_route != "ria":
        $ progression_note_ending()
        return
    $ chapter = "리아 R08 · 조용해도 괜찮은 아침"
    if memory.get("ria_r07_intimacy") == "shared":
        $ location = "일요일 아침 · 리아의 집"
        "아침에 식탁을 정리하던 리아가 빵 두 조각을 접시에 놓는다."
        r "[ri('오늘 추천 코스는 식탁. 예약 필요 없어~', '오늘 추천 코스는 식탁이에요. 예약 필요 없어요~')]"
        d "[ri('좋네. 자리도 하나 남았고.', '좋네요. 자리도 하나 남았고요.')]"
        r "[ri('남긴 거지! 오늘은 누구 기다리는지 알고.', '남긴 거죠! 오늘은 누구 기다리는지 알고요.')]"
        "도현이 빵을 한 입 베어 물었다. 리아는 자기 빵 대신 도현 쪽의 굽기를 살폈다."
        d "[ri('왜? 내 게 더 잘 구워졌어?', '왜요? 제 게 더 잘 구워졌어요?')]"
        r "[ri('응. 두 개 중에 골라 준 거야. 티 안 내려고 했는데~', '네. 두 개 중에 골라 드린 거예요. 티 안 내려고 했는데요~')]"
        d "[ri('바꿀래?', '바꾸실래요?')]"
        r "[ri('아니. 맛있게 먹으라고!', '아뇨. 맛있게 드시라고요!')]"
        "도현이 나머지도 먹자 리아도 자기 빵을 집었다. 아침을 마친 도현은 자기 집에서 할 일을 하려고 점심 전에 돌아갔다."
        $ remember("ria_r08_breakfast_shared")
    $ location = "일요일 낮 · 각자의 집, 개인 메시지"
    call ria_r08_phone_conversation
    $ remember("ria_r08_messages_received")
    "도현은 휴대폰을 책상 옆에 놓고 메모를 펼친다. 리아에게 보낸 말 때문에 혼자 있는 방도 조금 다르게 느껴졌다."
    $ location = "같은 날 낮 · 리아의 집 — 리아 시점"
    "리아는 가게 지도를 열었다가 닫는다. 방금 받은 답장을 한 번 더 읽었다."
    rn "다음에 어디 가지, 먼저 찾으려고 했네."
    if memory.get("ria_r08_reply") == "miss":
        rn "...보고 싶다는 말, 생각보다 오래 남는다."
    elif memory.get("ria_r08_reply") == "evening":
        rn "저녁에 들을 얘기가 있네. 사진 정리한 얘기랑, 내 빨래 얘기."
    else:
        rn "그때는 나만 할 말 찾는 줄 알았는데. 다음엔 먼저 옆자리 비워 둬야겠다."
    "리아가 휴대폰을 내려놓고 다 마른 수건을 접는다. 지도에 새 장소를 저장하지는 않았다."
    $ location = "같은 날 낮 · 도현의 집 — 도현 시점"
    "다시 펼친 메모의 빈 줄에 오늘 날짜를 적는다. 아직 완성하지 못한 기록은 천천히 이어 갈 생각이다."
    $ award_once("ria_R08", "ria", 4)
    $ progression_note_ending()
    return
