# R05-R08 and the existing optional O01 slot. No new visual assets.

label ria_r05:
    $ progression_enter("ria_r05")
    $ progression_checkpoint("ria_r05")
    if not dating or active_route != "ria":
        $ progression_note_ending()
        return
    $ chapter = "리아 R05 · 둘이 만드는 저녁"
    $ location = "교제 후 첫 토요일 · 동네 산책길"
    "다음 날 서로의 시간을 확인하고, 토요일 저녁에 만나기로 했다. 리아가 약속한 모퉁이에서 손을 흔든다."
    r "[ri('오늘은 문 열었어! 확인 두 번 했어~', '오늘은 문 열었어요! 확인 두 번 했어요~')]"
    d "[ri('그럼 오늘 첫 번째 성공은 만나는 거네.', '그럼 오늘 첫 번째 성공은 만나는 거네요.')]"
    r "[ri('그건 벌써 성공했지. 남자친구 도착했으니까.', '그건 벌써 성공했죠. 남자친구 도착했으니까요.')]"
    dn "익숙한 목소리로 낯선 호칭을 들었다. 대답이 반 박자 늦었다."
    d "[ri('여자친구도 확인했고. 이제 어디 가면 돼?', '여자친구도 확인했고요. 이제 어디 가면 돼요?')]"
    r "[ri('...생각보다 바로 받아치네!', '...생각보다 바로 받아치시네요!')]"
    "도현은 골목 끝으로 기울어진 햇빛을 보고 잠깐 걸음을 늦춘다."
    r "[ri('저쪽 보고 있었지? 기록집에 넣을 데야?', '저쪽 보고 계셨죠? 기록집에 넣을 곳이에요?')]"
    d "[ri('응. 그런데 먼저 밥 먹으러 가도 돼.', '네. 그런데 먼저 밥 먹으러 가도 돼요.')]"
    r "[ri('가도 되는 쪽 말고, 하고 싶은 쪽은?', '가도 되는 쪽 말고, 하고 싶은 쪽은요?')]"
    d "[ri('십 분만 걷고 싶어. 저 빛은 밥 먹고 나오면 없을 것 같아서.', '십 분만 걷고 싶어요. 저 빛은 밥 먹고 나오면 없을 것 같아서요.')]"
    r "[ri('좋아. 나는 일곱 시 전에는 먹고 싶어. 지금 배고픔이 꽤 진심이야.', '좋아요. 저는 일곱 시 전에는 먹고 싶어요. 지금 배고픔이 꽤 진심이에요.')]"
    d "[ri('그럼 사진은 짧게, 저녁은 길게.', '그럼 사진은 짧게, 저녁은 길게요.')]"
    $ progression_enter("ria_r05.choice01")
    $ progression_checkpoint("ria_r05.choice01")
    menu:
        "같이 골목을 걷고, 눈에 들어오는 것을 하나씩 고른다.":
            $ remember("ria_r05_plan", "together")
            d "[ri('같이 봐 줄래? 네 눈에는 뭐가 먼저 보이는지도 궁금해.', '같이 봐 주실래요? 리아 씨 눈에는 뭐가 먼저 보이는지도 궁금해요.')]"
            r "[ri('나는 저 화분. 햇빛보다 물 달라고 하는 것 같은데?', '저는 저 화분요. 햇빛보다 물 달라고 하는 것 같은데요?')]"
            d "[ri('난 그림자만 보고 있었는데~', '저는 그림자만 보고 있었는데요~')]"
            "리아가 고른 화분과 벽의 그림자를 함께 담는다. 도현은 사진 옆에 ‘물 줄 시간’이라고 짧게 적는다."
            $ remember("ria_r05_booklet_subject", "화분과 그림자")
            r "[ri('이런 건 조언료 받아야 되는데.', '이런 건 조언료 받아야 되는데요.')]"
            d "[ri('그럼 식후 음료는 내가 살게. 물 말고 골라.', '그럼 식후 음료는 제가 살게요. 물 말고 고르세요.')]"
        "사진을 찍는 동안 리아에게 저녁 메뉴 후보를 부탁한다.":
            $ remember("ria_r05_plan", "split")
            d "[ri('사진 두 장만 찍을게. 그동안 메뉴 후보 두 개만 골라 줄래?', '사진 두 장만 찍을게요. 그동안 메뉴 후보 두 개만 골라 주실래요?')]"
            r "[ri('응. 결정은 같이 하는 거다? 나중에 아무거나 금지!', '네. 결정은 같이 하는 거예요? 나중에 아무거나 금지!')]"
            "도현은 벽을 가로지르는 그림자를 찍고 촬영을 마친다. 리아는 휴대폰에 두 메뉴를 띄워 보여준다."
            $ remember("ria_r05_booklet_subject", "골목의 긴 그림자")
            r "[ri('국수랑 덮밥. 오늘은 어느 쪽?', '국수랑 덮밥요. 오늘은 어느 쪽이에요?')]"
            d "[ri('덮밥. 네 추천 기다리다가 더 배고파졌어.', '덮밥요. 추천 기다리다가 더 배고파졌어요.')]"
            r "[ri('좋아~ 내 한 표까지 두 표!', '좋아요~ 제 한 표까지 두 표!')]"
        "사진은 한 장만 남기고, 리아와 제목을 함께 정한다.":
            $ remember("choice_third_r05_plan")
            $ remember("ria_r05_plan", "caption")
            $ remember("ria_r05_booklet_subject", "함께 제목을 붙인 골목의 빛")
            "도현은 골목의 빛을 한 장 찍고 카메라를 넣었다. 노트의 제목 칸을 리아에게 보여준다."
            d "[ri('제목 좀 도와줄래? 혼자 고치면 저녁시간 넘길 것 같아서.', '제목 좀 도와주실래요? 혼자 고치면 저녁시간 넘길 것 같아서요.')]"
            r "[ri('그럼 배고파지기 전의 골목! 지금 우리한테 제일 중요한 거~', '그럼 배고파지기 전의 골목! 지금 우리한테 제일 중요한 거요~')]"
            $ remember("ria_r05_joint_caption", "배고파지기 전의 골목")
            d "[ri('제목은 정했고, 이제 저녁 고르자. 그건 진지하게.', '제목은 정했고요. 이제 저녁 골라요. 그건 진지하게요.')]"
    $ remember("ria_r05_record_time_kept")
    "약속한 시간 안에 골목을 나와 가게로 간다. 주문을 마치자 리아가 도현 앞에 물을 따라 주고는 자기 잔도 밀었다."
    r "[ri('남자친구 서비스~ 이쪽도 부탁해.', '남자친구 서비스예요~ 이쪽도 부탁해요.')]"
    d "[ri('우리 물은 각자 따라도 되는데.', '우리 물은 각자 따라도 되는데요.')]"
    r "[ri('알아. 그냥 한번 해 보고 싶었어.', '알아요. 그냥 한번 해 보고 싶었어요.')]"
    "도현이 리아의 잔을 채워 줬다. 음식이 나오자 리아는 첫술을 뜨기도 전에 노트를 가리켰다."
    d "[ri('오늘 사진은 밥 먹고 보여 줄래. 아까 저녁은 길게 먹기로 했잖아.', '오늘 사진은 밥 먹고 보여 드릴래요. 아까 저녁은 길게 먹기로 했잖아요.')]"
    r "[ri('오, 내 밥시간 지켜 주네. 그럼 나도 먹을 땐 감상 안 할게!', '오, 제 밥시간 지켜 주시네요. 그럼 저도 먹을 땐 감상 안 할게요!')]"
    "처음 몇 입은 둘 다 말이 없었다. 리아가 빈 잔을 보자 도현이 이번에는 묻기 전에 물병을 들었다. 그릇이 비고 나서야 도현은 아까 찍은 사진을 펼쳤다."
    $ location = "토요일 저녁 · 동네 식당"
    if memory.get("ria_r05_plan") == "together":
        r "[ri('사진 속 화분은 평화롭네. 나만 목마른 얼굴로 옆에 있었는데~', '사진 속 화분은 평화롭네요. 저만 목마른 얼굴로 옆에 있었는데요~')]"
        d "[ri('네 말도 적어 놨어. 이 사진 해설은 물 한 잔 마시고 읽는 걸로.', '하신 말도 적어 놨어요. 이 사진 해설은 물 한 잔 마시고 읽는 걸로요.')]"
    elif memory.get("ria_r05_plan") == "caption":
        r "[ri('배고파지기 전의 골목... 이제 제목 유효기간 끝났네~', '배고파지기 전의 골목... 이제 제목 유효기간 끝났네요~')]"
        d "[ri('밥 먹고 읽어도 그때가 생각나면 성공이지.', '밥 먹고 읽어도 그때가 생각나면 성공이죠.')]"
    else:
        r "[ri('딱 두 장 찍고 왔네. 한 장만 더, 안 하네?', '딱 두 장 찍고 오셨네요. 한 장만 더, 안 하시네요?')]"
        d "[ri('같이 먹는 약속도 내가 하고 싶은 거니까.', '같이 먹는 약속도 제가 하고 싶은 거니까요.')]"
    r "[ri('다음엔 사진 찍는 날이라고 먼저 말해 줘. 나도 구경할 준비 하고 나오게.', '다음엔 사진 찍는 날이라고 먼저 말해 주세요. 저도 구경할 준비 하고 나오게요.')]"
    d "[ri('그럼 다음 토요일도 같이 걸을래? 시간은 둘 다 일정 보고 정하고.', '그럼 다음 토요일도 같이 걸으실래요? 시간은 둘 다 일정 보고 정하고요.')]"
    r "[ri('응! 나는 오전 약속 있으니까 오후로 보자.', '네! 저는 오전 약속 있으니까 오후로 봐요.')]"
    $ remember("ria_r05_next_walk", "토요일 오후 후보, 시각 미정")
    $ award_once("ria_R05", "ria", 4)
    $ progression_note_ending()
    return

label ria_o01_offer:
    $ progression_enter("ria_o01_offer")
    $ progression_checkpoint("ria_o01_offer")
    if not dating or active_route != "ria" or memory.get("ria_o01_status"):
        $ progression_note_ending()
        return
    $ progression_enter("ria_o01_offer.choice01")
    $ progression_checkpoint("ria_o01_offer.choice01")
    menu:
        "잠깐 만나기 — 점심 메뉴의 작은 내기 (선택 일상)":
            call ria_o01
        "본편 계속 — 다음 만남으로":
            $ remember("ria_o01_status", "skipped")
        "오늘은 짧은 인사만 — 다음 점심을 기약하고 본편 계속":
            $ remember("choice_third_o01_offer")
            $ location = "다음 날 점심 · 개인 메시지"
            call phone_deliver("ria_o01_offer_01", "dohyun", ri('오늘 점심은 따로 먹어야겠다. 다음에 메뉴 맞히기는 내가 먼저 할게~', '오늘 점심은 따로 먹어야겠어요. 다음에 메뉴 맞히기는 제가 먼저 할게요~'))
            call phone_deliver("ria_o01_offer_02", "ria", ri('예약 접수! 대신 힌트는 한 번만 줄 거야~', '예약 접수! 대신 힌트는 한 번만 드릴 거예요~'))
            $ remember("ria_o01_status", "brief")
    $ progression_note_ending()
    return

label ria_o01:
    $ progression_enter("ria_o01")
    $ progression_checkpoint("ria_o01")
    $ chapter = "리아 O01 · 점심 메뉴의 작은 내기"
    $ location = "다음 주 평일 점심 · 회사 근처 식당"
    "서로 점심 시간이 맞아 회사 근처에서 잠깐 만났다. 리아가 메뉴판 위쪽만 도현 쪽으로 기울인다."
    r "[ri('내가 고를 거 맞혀 봐. 힌트는... 배고파.', '제가 고를 거 맞혀 보세요. 힌트는... 배고파요.')]"
    d "[ri('그 힌트는 매번 유효한데?', '그 힌트는 매번 유효한데요?')]"
    r "[ri('정확도 높은 힌트지~', '정확도 높은 힌트죠~')]"
    $ progression_enter("ria_o01.choice01")
    $ progression_checkpoint("ria_o01.choice01")
    menu:
        "매콤한 덮밥을 가리킨다.":
            $ remember("ria_o01_guess", "rice")
            d "[ri('오늘은 이거. 메뉴 보자마자 멈췄잖아.', '오늘은 이거요. 메뉴 보자마자 멈추셨잖아요.')]"
            r "[ri('앗, 들켰네! 나 말고 메뉴 봐~', '앗, 들켰네요! 저 말고 메뉴 보세요~')]"
            d "[ri('둘 다 보는 중이야.', '둘 다 보는 중이에요.')]"
        "시원한 국수를 가리킨다.":
            $ remember("ria_o01_guess", "noodles")
            d "[ri('날 더우니까 이거?', '날 더우니까 이거요?')]"
            r "[ri('그럴듯한데 오늘은 매콤한 덮밥! 취향 시험은 다음 기회에~', '그럴듯한데 오늘은 매콤한 덮밥요! 취향 시험은 다음 기회에~')]"
            d "[ri('답 바뀌는 시험이네. 다음엔 또 물어봐야겠다.', '답 바뀌는 시험이네요. 다음엔 또 물어봐야겠어요.')]"
        "정답보다 리아가 먹고 싶은 이유를 힌트로 청한다.":
            $ remember("choice_third_o01_guess")
            $ remember("ria_o01_guess", "hint")
            d "[ri('힌트 하나만 더. 오늘 매콤한 게 생각난 이유는?', '힌트 하나만 더요. 오늘 매콤한 게 생각난 이유는요?')]"
            r "[ri('앗, 메뉴는 벌써 맞혔네! 오전 내내 그 소스 생각했어.', '앗, 메뉴는 벌써 맞히셨네요! 오전 내내 그 소스 생각했어요.')]"
            d "[ri('그럼 취향 말고 오늘 기분까지 알아낸 걸로~', '그럼 취향 말고 오늘 기분까지 알아낸 걸로요~')]"
            r "[ri('관찰 범위가 점점 커지는데? 나도 다음엔 그렇게 물어볼래.', '관찰 범위가 점점 커지는데요? 저도 다음엔 그렇게 물어볼래요.')]"
    r "[ri('너는?', '도현 씨는요?')]"
    d "[ri('난 국수. 네 거 맞히느라 내 메뉴 말할 걸 놓쳤네.', '저는 국수요. 맞히느라 제 메뉴 말할 걸 놓쳤네요.')]"
    "각자 고른 메뉴를 주문했다. 맞혔는지와 상관없이 점심은 같은 테이블에서 먹었다."
    r "[ri('다음 내기는 네 메뉴로 하자. 힌트 제대로 주고!', '다음 내기는 도현 씨 메뉴로 해요. 힌트 제대로 주시고요!')]"
    $ remember("ria_o01_meal", "리아는 매콤한 덮밥, 도현은 국수")
    $ remember("ria_o01_status", "completed")
    $ award_once("ria_O01", "ria", 2)
    $ progression_note_ending()
    return

label ria_r06:
    $ progression_enter("ria_r06")
    $ progression_checkpoint("ria_r06")
    if not dating or active_route != "ria":
        $ progression_note_ending()
        return
    $ chapter = "리아 R06 · 재밌어야만 하는 걸까"
    $ location = "그 주 평일 저녁 · 동네 카페"
    "퇴근 후 잠깐 보기로 한 날, 리아의 휴대폰에는 가게 이름이 세 개나 떠 있었다."
    r "[ri('여긴 늦게까지 하고, 여긴 새 메뉴가 있대. 아니면 조금 걸어도 되고!', '여긴 늦게까지 하고, 여긴 새 메뉴가 있대요. 아니면 조금 걸어도 되고요!')]"
    d "[ri('지금 앉은 데도 꽤 괜찮은데?', '지금 앉은 데도 꽤 괜찮은데요?')]"
    r "[ri('여긴 그냥 기다리려고 온 데잖아.', '여긴 그냥 기다리려고 온 곳이잖아요.')]"
    d "[ri('나는 만나려고 왔어. 이제 만났고.', '저는 만나려고 왔어요. 이제 만났고요.')]"
    "리아가 화면을 내리다가 손가락을 멈춘다."
    r "[ri('...나 사실 오늘 조금 졸려. 방금 가게 이름도 두 번 읽었어.', '...저 사실 오늘 조금 졸려요. 방금 가게 이름도 두 번 읽었어요.')]"
