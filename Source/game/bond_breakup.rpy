# 신뢰가 바닥까지 떨어지면(BOND_BREAKUP_TRUST 이하) R14 뒤에 히로인이 먼저 이별을 꺼낸다.
# 갈등을 '해결'했어도, 그동안 쌓인 선택이 신뢰를 다 깎았다면 관계는 이어지지 않는다.

define BOND_BREAKUP_TRUST = -3

label bond_breakup(who):
    call expression (who + "_breakup")
    return

label bond_breakup_close(who):
    $ dating = False
    $ remember(who + "_relationship_closed")
    $ remember(who + "_breakup_by_heroine")
    $ ending = who + "_relationship_closed"
    $ cream_focus = None
    $ progression_note_ending()
    return

label ria_breakup:
    $ chapter = "리아 · 재미없는 날의 대답"
    $ location = "그 주 토요일 저녁 · 리아의 집 앞"
    $ cream_focus = "ria"
    "토요일 저녁. 약속한 네 시보다 한참 지나서야 리아에게서 집 앞으로 와 달라는 메시지가 왔다."
    "리아는 현관 계단에 앉아 있었다. 늘 들고 다니던 가게 목록 노트가 무릎 위에 덮여 있었다."
    r "[ri('왔어? 앉아. ...오늘은 코스 없어. 진짜로.', '오셨어요? 앉으세요. ...오늘은 코스 없어요. 진짜로요.')]"
    $ face("ria", "teary")
    r "[ri('나 요즘 계속 생각했어. 너랑 있으면 좋은데, 나 자꾸 웃고 있더라. 웃어야 할 것 같아서.', '저 요즘 계속 생각했어요. 도현 씨랑 있으면 좋은데, 저 자꾸 웃고 있더라고요. 웃어야 할 것 같아서요.')]"
    d "[ri('내가 그렇게 만들었어?', '제가 그렇게 만들었어요?')]"
    r "[ri('너만 그런 건 아니야. 나도 괜찮은 척했으니까. 근데 힘들다고 했을 때, 넌 다음엔 더 재밌게 하자고 했잖아.', '도현 씨만 그런 건 아니에요. 저도 괜찮은 척했으니까요. 근데 힘들다고 했을 때, 도현 씨는 다음엔 더 재밌게 하자고 했잖아요.')]"
    "리아가 노트를 펼쳤다. 다음에 갈 가게 이름들 사이에, 연필로 작게 적힌 한 줄이 있었다. '오늘은 재미없어도 돼?'"
    r "[ri('이 말을 너한테 하고 싶었는데, 끝까지 못 했어. 그래서... 우리 여기까지 하자.', '이 말을 도현 씨한테 하고 싶었는데, 끝까지 못 했어요. 그래서... 우리 여기까지 해요.')]"
    d "[ri('...알겠어. 말해 줘서 고마워.', '...알겠어요. 말해 줘서 고마워요.')]"
    r "[ri('월요일에 회사에선 원래대로 할게. 나 그건 잘하잖아.', '월요일에 회사에선 원래대로 할게요. 저 그건 잘하잖아요.')]"
    "리아는 웃었다. 이번에도 웃었다. 그게 가장 마음에 걸렸다."
    dn "재미없어도 된다는 말을 내가 먼저 해 줬다면, 리아는 노트에 그 문장을 적을 필요가 없었을 거다."
    "리아 결말 · 서로의 자리로"
    call bond_breakup_close("ria")
    return

label jihyun_breakup:
    $ chapter = "지현 · 결론부터 말할게"
    $ location = "발표 다음 날 저녁 · 사무실 자리"
    $ cream_focus = "jihyun"
    "발표가 끝난 다음 날 저녁. 지현이 메신저로 회의실 번호만 보냈다. 업무 메시지와 똑같은 말투였다."
    call pc_chat("jihyun", [("jihyun", "702호.")])
    $ location = "발표 다음 날 저녁 · 빈 회의실"
    "지현은 창가에 서 있었다. 테이블 위에는 아무 서류도 없었다. 그게 오히려 낯설었다."
    $ face("jihyun", "teary")
    j "결론부터 말할게. 우리 그만 만나자."
    d "...이유를 들어도 될까요."
    j "응. 이번엔 너한테 묻지도 않고 정한 거 아니야. 몇 주 동안 계속 생각했어."
    j "난 묻지도 않고 정했고 넌 한 발 물러섰지. 그러다 보니 우리, 회의실에서만 얘기하더라."
    d "제가 더 말했어야 했어요."
    j "나도 물어봤어야지. 누구 탓으로 돌리진 말자. 이제 같은 팀으로 지내자."
    "지현이 창에 비친 자기 얼굴을 잠깐 봤다가, 도현 쪽으로 돌아섰다. 팀장의 얼굴이 아니었다."
    j "업무는 그대로 해. 네 안은 좋은 안이야. 그건 연애랑 상관없이 내가 끝까지 지킬게."
    j "...그리고 고마웠어. 일정표에 비워 둔 칸, 한동안은 그대로 둘 거야."
    dn "첫마디는 바로 나왔는데 마지막 말까진 한참 걸렸다."
    "지현 결말 · 서로의 자리로"
    call bond_breakup_close("jihyun")
    return

label yujin_breakup:
    $ chapter = "유진 · 제 말로 할게요"
    $ location = "금요일 오후 네 시 십 분 · 회사 3층 복도 끝 창문"
    $ cream_focus = "yujin"
    "금요일 오후 네 시 십 분. 유진이 처음으로 먼저 3층 복도 끝으로 불렀다."
    "창틀에 기댄 유진의 손엔 컵받침이 아니라 접힌 메모지가 들려 있었다."
    $ face("yujin", "teary")
    y "오늘은 제가 처음부터 끝까지 말할게요. 중간에... 도와주지 마세요."
    d "네."
    "유진은 메모지를 펴지 않았다. 외워 온 것 같았다."
    y "제가 말하다 막히면 늘 도현 씨가 와 주셨잖아요. 근데 저는... 아직 할 말이 남아 있었거든요."
    y "고맙다고 하고 나면 다음 말이 안 나왔어요. 서운하기도 하단 말이요."
    d "...말해 줘서 고마워요. 제가 너무 서둘렀어요."
    y "알아요. 일부러 그러신 게 아닌 걸 아니까 더 말하기 어려웠어요."
    "빛이 바닥을 지나 벽으로 꺾였다. 유진은 도현을 보고 있었다."
    y "우리, 여기까지 해요. 저 이제 제 말은 제가 할 수 있을 것 같아요. 도현 씨 덕분이기도 해요. 그건 진짜예요."
    "유진이 메모지를 접은 채 도현 손에 쥐여 줬다. 펴 보지 말라는 듯 손등을 한 번 눌렀다."
    dn "네 시 십 분의 빛이 꺾이는 걸, 오늘은 처음으로 보지 못했다."
    "유진 결말 · 서로의 자리로"
    call bond_breakup_close("yujin")
    return

label seoyun_breakup:
    $ chapter = "서윤 · 농담 없이 하는 말"
    $ location = "수요일 밤 · 서윤의 작업실 앞"
    $ cream_focus = "seoyun"
    "수요일 밤. 서윤은 작업실 문을 열지 않고 계단에 앉아 있었다. 손에 든 캔커피는 따지 않은 채였다."
    $ face("seoyun", "teary")
    s "오늘은 안 들어가. 들어가면 또 아무렇지 않은 척할 것 같아서."
    d "...무슨 얘기인지 알 것 같아요."
    s "응. 넌 늘 눈치가 빨라. 그래서 더 미안해."
    s "그 사람 일 있었을 때, 넌 맞는 말만 했어. 밀어내지 말라고, 정하지 말라고. 다 맞는 말인데... 난 그 말들 앞에서 계속 혼나는 기분이었어."
    s "결혼했을 때도 그랬거든. 맞는 말 듣고, 웃고, 넘기고. 너한테까지 그러고 싶지 않아."
    d "제가 더 들었어야 했어요. 말하기 전에."
    s "나도 농담 말고 진짜를 더 일찍 말했어야 했고. ...그래서 오늘은 농담 없이 말할게."
    "서윤은 도현 쪽으로 캔커피를 건넸다. 이번엔 웃음기 없는 목소리로 입을 열었다."
    s "우리 여기서 멈추자. 네가 싫어서가 아니라, 지금의 내가 너를 제대로 못 대해서."
    d "...알겠어요. 대신 회사에서는 지금처럼 웃어 주세요."
    s "그건 자신 있어~ ...이건 농담이야. 마지막 농담."
    dn "다시 보자는 말이 없었다. 이번엔 나도 언제 한번 보자고 하지 않았다."
    "서윤 결말 · 서로의 자리로"
    call bond_breakup_close("seoyun")
    return
