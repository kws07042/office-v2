# Existing R09-R12 and optional O02 slots. Art and voice remain pending.

label ria_r09:
    $ progression_enter("ria_r09")
    $ progression_checkpoint("ria_r09")
    if not dating or active_route != "ria":
        $ progression_note_ending()
        return
    $ chapter = "리아 R09 · 분위기 담당이라는 말"
    $ location = "다음 주 화요일 오후 · 온빛브랜딩"
    "현장 사진 속 안내판 앞에 사람들이 바글바글하다. 리아가 화면을 돌려 두 장을 나란히 놓는다."
    r "[ri('여기는 줄이 아니라 길을 묻는 사람들이야. 입구에서 안내를 못 찾은 거지.', '여기는 줄이 아니라 길을 묻는 사람들이에요. 입구에서 안내를 못 찾은 거죠.')]"
    d "[ri('그래서 입구 사진도 따로 찍어 둔 거구나.', '그래서 입구 사진도 따로 찍어 두신 거군요.')]"
    r "[ri('응. 직원 한 명 더 세우기 전에, 안내판 위치부터 바꿔 보고 싶어.', '네. 직원 한 명 더 세우기 전에, 안내판 위치부터 바꿔 보고 싶어요.')]"
    "다른 팀에서 넘어온 짧은 메모에는 ‘현장 분위기는 강리아 매니저 덕분에 좋았음’이라고 적혀 있었다. 리아는 웃다가 펜 뚜껑을 닫는다."
    r "[ri('좋은 말인데... 내가 사람들 웃긴 것만 남았네. 하하.', '좋은 말인데... 제가 사람들 웃긴 것만 남았네요. 하하.')]"
    d "[ri('이 두 사진은 분위기 좋아서 찍힌 게 아닌데.', '이 두 사진은 분위기 좋아서 찍힌 게 아닌데요.')]"
    r "[ri('...그치. 너라도 봐 줘서 다행이다.', '...그쵸. 도현 씨라도 봐 주셔서 다행이에요.')]"
    $ progression_enter("ria_r09.choice01")
    $ progression_checkpoint("ria_r09.choice01")
    menu:
        "리아가 판단 근거를 직접 설명하도록 질문을 건넨다.":
            $ remember("ria_r09_support", "explain")
            d "[ri('그럼 검토 자리에서 이것부터 보여 줄래? 위치를 바꿔야 한다는 근거.', '그럼 검토 자리에서 이것부터 보여 주실래요? 위치를 바꿔야 한다는 근거요.')]"
            r "[ri('내가 설명할게. 너는 앞뒤 사진 넘겨 줘. 비교가 한 번에 보이게.', '제가 설명할게요. 도현 씨는 앞뒤 사진 넘겨 주세요. 비교가 한 번에 보이게요.')]"
            "짧은 검토 자리. 도현은 두 사진을 나란히 띄웠고, 리아는 실제로 받은 질문과 위치 변경안을 자기 말로 풀었다."
            r "사람을 더 배치하는 안은 이 변경 뒤에도 막힐 때 다시 보겠습니다. 우선 한 번에 길을 찾게 바꿔 볼게요."
            $ remember("ria_r09_action", "리아가 근거와 변경안을 직접 설명, 도현은 사진 비교 지원")
        "리아와 함께 전후 사진·질문 기록을 짧게 정리한다.":
            $ remember("ria_r09_support", "organize")
            d "[ri('질문 기록이랑 사진을 한 장에 같이 넣자. 네 판단이 자료에도 남게.', '질문 기록이랑 사진을 한 장에 같이 넣어요. 리아 씨 판단이 자료에도 남게요.')]"
            r "[ri('좋아. 사진 순서는 같이 보고, 위치 바꾸는 이유는 내가 쓸게.', '좋아요. 사진 순서는 같이 보고, 위치 바꾸는 이유는 제가 쓸게요.')]"
            "도현은 반복된 질문을 묶고 리아는 변경 이유를 적었다. 정리한 한 장의 담당자 칸에 리아의 이름이 들어간다."
            r "[ri('오, 이렇게 보니까 뭘 바꾸려는 건지 한눈에 보이네.', '오, 이렇게 보니까 뭘 바꾸려는 건지 한눈에 보이네요.')]"
            $ remember("ria_r09_action", "둘이 질문·사진 정리, 리아가 변경 이유와 담당자 이름 기록")
        "리아가 설명할 내용을 먼저 들어 주고 질문을 맞춰 본다.":
            $ remember("choice_third_r09_support")
            $ remember("ria_r09_support", "rehearse")
            d "[ri('들어 줄까? 내가 헷갈린 부분만 물어볼게. 설명은 네 말로 남게.', '들어 드릴까요? 제가 헷갈린 부분만 물어볼게요. 설명은 리아 씨 말로 남게요.')]"
            r "[ri('좋아. 대신 칭찬만 하기 없기! 진짜 질문 하나 해 줘.', '좋아요. 대신 칭찬만 하기 없기! 진짜 질문 하나 해 주세요.')]"
            "도현이 안내판을 바꾼 뒤의 확인 방법을 묻는다. 리아는 질문을 적어 두고 검토 자리에서 직접 설명했다."
            $ remember("ria_r09_action", "도현과 질문 예행연습, 리아가 근거와 확인 방법을 직접 설명")
    $ remember("ria_r09_competence_seen")
    $ location = "화요일 퇴근 후 · 동네 식당"
    "자료를 보내고 일을 마친 뒤, 회사 밖에서 저녁을 먹었다."
    r "[ri('오늘 내 칭찬 좀 구체적이던데? 준비했어?', '오늘 제 칭찬 좀 구체적이던데요? 준비하셨어요?')]"
    d "[ri('관찰은 늘 하고 있었지. 너 웃는 것까지 포함해서.', '관찰은 늘 하고 있었죠. 웃으시는 것까지 포함해서요.')]"
    r "[ri('...업무 끝나자마자 이러기야~', '...업무 끝나자마자 이러시기예요~')]"
    d "[ri('지금은 데이트니까.', '지금은 데이트니까요.')]"
    "식당을 나와 버스 정류장까지 천천히 걸었다. 리아가 도현의 소매를 가볍게 잡았다."
    r "[ri('오늘 내가 한 말 중에 뭐가 제일 기억나?', '오늘 제가 한 말 중에 뭐가 제일 기억나요?')]"
    if memory.get("ria_r09_support") == "organize":
        d "[ri('변경 이유는 네가 쓰겠다고 한 거. 그다음은 지금 나 붙잡은 거.', '변경 이유는 직접 쓰시겠다고 한 거요. 그다음은 지금 저 붙잡으신 거요.')]"
    else:
        d "[ri('네가 직접 설명한 거. 그다음은 지금 나 붙잡은 거.', '직접 설명하신 거요. 그다음은 지금 저 붙잡으신 거요.')]"
    r "[ri('...그건 말 안 했는데!', '...그건 말 안 했는데요!')]"
    d "[ri('그래서 더 잘 기억하려고.', '그래서 더 잘 기억하려고요.')]"
    "버스가 오자 리아가 손을 놓고 크게 흔들었다. 집에 도착해서는 서로 '도착' 메시지를 주고받았다."
    $ remember("ria_r09_date_close", "정류장에서 인사하고 각자 귀가")
    $ award_once("ria_R09", "ria", 6)
    $ progression_note_ending()
    return

label ria_r10:
    $ progression_enter("ria_r10")
    $ progression_checkpoint("ria_r10")
    if not dating or active_route != "ria":
        $ progression_note_ending()
        return
    $ chapter = "리아 R10 · 지도에 적은 다음"
    $ location = "그 주 토요일 오후 · 리아의 집"
    "리아가 동네 지도를 펼치자 접힌 모서리가 자꾸 들렸다. 도현이 노트로 한쪽을 누르고, 리아는 컵을 올리려다 둘의 팔이 겹친 걸 보고 멈췄다."
    r "[ri('파란 표시는 또 가고 싶은 데. 동그라미만 친 건 아직 안 가 본 데.', '파란 표시는 또 가고 싶은 곳이에요. 동그라미만 친 건 아직 안 가 본 곳이고요.')]"
    d "[ri('가는 길에 들어갔다가 좋아진 곳도 있어?', '가는 길에 들어갔다가 좋아진 곳도 있어요?')]"
    r "[ri('응. 여기 빵집. 간판보다 냄새가 먼저 사람을 잡아끌어~', '네. 여기 빵집요. 간판보다 냄새가 먼저 사람을 잡아끌어요~')]"
    if afterwork_preference == "quiet":
        r "[ri('첫날 조용한 자리 찾았잖아. 이번엔 이런 작은 공원은 어때?', '첫날 조용한 자리 찾으셨잖아요. 이번엔 이런 작은 공원은 어때요?')]"
    elif afterwork_preference == "meal":
        r "[ri('처음 같이 메뉴 고르던 날 생각난다. 이번에는 먹기 전에 사진부터?', '처음 같이 메뉴 고르던 날 생각나네요. 이번에는 먹기 전에 사진부터요?')]"
    elif afterwork_preference == "suggestion":
        r "[ri('첫날엔 내 추천 들어 줬으니까, 오늘은 네가 고른 데도 가 보고 싶어.', '첫날엔 제 추천 들어 주셨으니까, 오늘은 도현 씨가 고른 곳도 가 보고 싶어요.')]"
    else:
        r "[ri('오늘은 네 기록집에 남기고 싶은 데부터 골라 보자.', '오늘은 도현 씨 기록집에 남기고 싶은 곳부터 골라 봐요.')]"
    if memory.get("ria_r05_booklet_subject") == "화분과 그림자":
        "도현은 ‘물 줄 시간’ 메모가 있는 사진을 펼쳤다. 리아가 화분을 알아보고 웃는다."
        r "[ri('그날 화분이다! 오늘은 물 안 줘도 되는 애로 골라 줘야겠네.', '그날 화분이네요! 오늘은 물 안 줘도 되는 애로 골라 드려야겠네요.')]"
    elif memory.get("ria_r05_booklet_subject") == "골목의 긴 그림자":
        "도현은 그날 찍은 골목의 그림자를 보여줬다."
        r "[ri('딱 두 장 찍고 덮밥 먹으러 왔던 날. 오늘도 시간 예약하고 찍자~', '딱 두 장 찍고 덮밥 먹으러 오셨던 날이네요. 오늘도 시간 예약하고 찍어요~')]"
    d "[ri('사진은 고르겠는데 순서가 어렵네. 앞에 두면 좋을 장소 같이 봐 줄래?', '사진은 고르겠는데 순서가 어렵네요. 앞에 두면 좋을 장소 같이 봐 주실래요?')]"
    r "[ri('좋아. 대신 빵집 빼라고 하면 한 번은 항의할 거야!', '좋아요. 대신 빵집 빼라고 하시면 한 번은 항의할 거예요!')]"
    $ progression_enter("ria_r10.choice01")
    $ progression_checkpoint("ria_r10.choice01")
    menu:
        "작은 공원의 긴 의자를 기록집 첫 장소 후보로 고른다.":
            $ remember("ria_r10_place", "park")
            $ remember("ria_r10_place_name", "작은 공원의 긴 의자")
            d "[ri('이쪽. 빈자리가 있어서 첫 페이지로 좋을 것 같아.', '이쪽이요. 빈자리가 있어서 첫 페이지로 좋을 것 같아요.')]"
            r "[ri('나도 여기 좋아해. 여기 앉으면 빵집도 보여. ...방금 항의 한 번 아꼈네~', '저도 여기 좋아해요. 여기 앉으면 빵집도 보여요. ...방금 항의 한 번 아꼈네요~')]"
            $ remember("ria_r10_impression", "도현은 빈자리, 리아는 잠깐 앉는 조용한 시간을 좋아함")
        "빵집 옆 골목을 기록집 첫 장소 후보로 고른다.":
            $ remember("ria_r10_place", "bakery")
            $ remember("ria_r10_place_name", "빵집 옆 골목")
            d "[ri('이쪽. 좋아하는 곳을 냄새로 찾았다는 얘기, 첫 장에 넣고 싶어.', '이쪽이요. 좋아하는 곳을 냄새로 찾았다는 얘기, 첫 장에 넣고 싶어요.')]"
            r "[ri('나도 빵 나오면 걸음 느려지는 거 좋아해. 사람들 얘기야. 나도 포함이고!', '저도 빵 나오면 걸음 느려지는 거 좋아해요. 사람들 얘기예요. 저도 포함이고요!')]"
            $ remember("ria_r10_impression", "도현은 냄새로 찾은 장소 이야기, 리아는 느려지는 걸음을 좋아함")
        "두 장소를 잇는 골목을 첫 페이지 후보로 고른다.":
            $ remember("choice_third_r10_place")
            $ remember("ria_r10_place", "between")
            $ remember("ria_r10_place_name", "공원과 빵집 사이의 골목")
            $ remember("ria_r10_impression", "목적지보다 함께 천천히 걷던 사이의 길")
            d "[ri('나는 그 사이 길이 궁금해. 어디 가는지보다 같이 걷는 시간이 남아서.', '저는 그 사이 길이 궁금해요. 어디 가는지보다 같이 걷는 시간이 남아서요.')]"
            r "[ri('그럼 다음엔 지름길 알려 주면 안 되겠네~', '그럼 다음엔 지름길 알려 드리면 안 되겠네요~')]"
            d "[ri('응. 오늘은 조금 돌아가는 쪽으로.', '네. 오늘은 조금 돌아가는 쪽으로요.')]"
    "지도에 작은 표시가 하나 늘었다. 도현의 노트에는 '직접 가서 보고 순서 정하기'라고 적혔다."
    $ remember("ria_r10_help_received", "리아의 장소 추천과 감상")
    $ remember("ria_r10_booklet_state", "첫 장소 후보 선정, 촬영과 첫 페이지 확정은 아직")
    r "[ri('사람 들어가는 페이지도 있어?', '사람 들어가는 페이지도 있어요?')]"
    d "[ri('있으면 네가 제일 처음 봐 줬으면 좋겠어.', '있으면 리아 씨가 제일 처음 봐 주셨으면 좋겠어요.')]"
    r "[ri('모델 제안인 줄 알았는데 독자 제안이네~', '모델 제안인 줄 알았는데 독자 제안이네요~')]"
    d "[ri('모델은 허락부터 받고. 독자는 벌써 기다리는 것 같아서.', '모델은 허락부터 받고요. 독자는 벌써 기다리시는 것 같아서요.')]"
    r "[ri('응. 기다린다? 완벽하게 만든다고 꽁꽁 숨겨 두기만 해 봐.', '네. 기다릴게요? 완벽하게 만든다고 꽁꽁 숨겨 두기만 해 보세요.')]"
    "지도를 접다가 리아가 회사 이름이 적힌 메모를 옆으로 밀었다."
    r "[ri('우리 얘기, 서윤 언니한테는 말해도 괜찮을 것 같아. 너는 어때?', '우리 얘기, 서윤 언니한테는 말해도 괜찮을 것 같아요. 도현 씨는 어때요?')]"
    d "[ri('회사 전체에 알리는 건 아니고, 서윤 씨 한 명에게?', '회사 전체에 알리는 건 아니고, 서윤 씨 한 명에게요?')]"
    r "[ri('응. 친한 사람 한 명한테는 내 입으로 말하고 싶어서. 싫으면 안 해도 돼.', '네. 친한 사람 한 명한테는 제 입으로 말하고 싶어서요. 싫으면 안 해도 돼요.')]"
    $ progression_enter("ria_r10.choice02")
    $ progression_checkpoint("ria_r10.choice02")
    menu:
        "서윤 한 명에게 교제 사실을 알리기로 함께 합의한다.":
            d "[ri('좋아. 둘이 같이 얘기하자. 알려도 된 건 우리가 사귄다는 데까지.', '좋아요. 둘이 같이 얘기해요. 알려도 된 건 우리가 사귄다는 데까지요.')]"
            r "[ri('응! 내일 시간 맞으면 개인 메시지로 같이 말하자.', '네! 내일 시간 맞으면 개인 메시지로 같이 말해요.')]"
            $ remember("ria_publicity", "agreed_seoyun")
            $ remember("ria_disclosure_plan", "서윤 한 명에게 교제 사실만 함께 전달")
        "당분간 둘만 알고 지내고 싶다고 말한다.":
