label ria_r01:
    $ chapter = "리아 R01 · 오늘은 동료 둘이"
    $ location = "다음 퇴근길 · 회사 앞"
    "리아가 자기 컵을 든 채 회사 앞에서 잠깐 기다리고 있다."
    r "[ri('도현아. 오늘 바로 집에 가?', '도현 씨. 오늘은 바로 집에 가세요?')]"
    d "[ri('왜? 추가 현장 배정?', '왜요? 추가 현장 배정인가요?')]"
    r "[ri('퇴근했거든~ 오늘은 내가 개인적으로 부르는 거야!', '퇴근했거든요~ 오늘은 제가 개인적으로 부르는 거예요!')]"
    d "[ri('그럼 내용부터 들어 보고.', '그럼 내용부터 들어 볼게요.')]"
    if c06_person == "ria" or c07_person == "ria":
        r "[ri('엄격하네. 잠깐 같이 들렀다 가자. 지난번에 못 다 한 얘기도 있고.', '엄격하시네요. 잠깐 같이 들렀다 가요. 지난번에 못 다 한 얘기도 있고요.')]"
    else:
        r "[ri('엄격하네. 잠깐 같이 들렀다 가자. 여럿 있을 때 못 물어본 것도 있어서.', '엄격하시네요. 잠깐 같이 들렀다 가요. 여럿 있을 때 못 물어본 것도 있어서요.')]"
    d "[ri('리아도 현장에서랑 지금이 좀 다르네.', '리아 씨도 현장에서랑 지금이 좀 다르네요.')]"
    r "[ri('어떻게?', '어떻게요?')]"
    d "[ri('현장에서는 목적지를 정해 놨잖아. 지금은 나한테 물어보는 중이고.', '현장에서는 목적지를 정해 놓으셨잖아요. 지금은 저한테 물어보는 중이고요.')]"
    r "[ri('...그럼 물어볼게. 어떤 데가 좋아?', '...그럼 물어볼게요. 어떤 데가 좋아요?')]"
    menu:
        "[ri('조용히 앉을 수 있는 곳.', '조용히 앉을 수 있는 곳이 좋아요.')]":
            $ afterwork_preference = "quiet"
            r "[ri('좋아. 사람 구경 코스는 다음에. 오늘은 내가 옆자리 앉아도 되는 곳으로.', '좋아요. 사람 구경 코스는 다음에요. 오늘은 제가 옆자리에 앉아도 되는 곳으로요.')]"
            "카페에 도착한 리아가 창가의 두 자리를 보고 맞은편을 가리킨다."
            r "[ri('여기면 조용하겠다. 난 저쪽 앉을게.', '여기면 조용하겠네요. 저는 저쪽에 앉을게요.')]"
            d "[ri('옆자리도 있는데. 아까 네가 앉아도 되는 곳이라며.', '옆자리도 있는데요. 아까 리아 씨가 앉아도 되는 곳이라고 하셨잖아요.')]"
            r "[ri('그 말 기억하고 있었어?!', '그 말 기억하고 계셨어요?!')]"
            d "[ri('내가 괜찮다고 말할 차례였잖아.', '제가 괜찮다고 말할 차례였잖아요.')]"
            "리아는 컵을 내려놓고 옆 의자를 당긴다."
            r "[ri('그럼 잠깐만. 나도 오늘은 질문 좀 덜 할게.', '그럼 잠깐만요. 저도 오늘은 질문 좀 덜 할게요.')]"
            d "[ri('질문해도 돼. 내가 너한테 물어볼 것도 있으니까.', '질문하셔도 돼요. 저도 리아 씨한테 물어볼 게 있으니까요.')]"
        "[ri('일단 가볍게 밥 먹자.', '일단 가볍게 밥 먹을까요?')]":
            $ afterwork_preference = "meal"
            r "[ri('나도 찬성!! 지금 멋있는 얘기 해도 머릿속엔 메뉴판만 떠올라~', '저도 찬성이에요!! 지금 멋있는 얘기 해도 머릿속엔 메뉴판만 떠올라요~')]"
            "간단히 먹을 수 있는 곳에 들어가 메뉴를 고른다. 리아는 자기 컵을 테이블에 내려놓는다."
            r "[ri('혹시 나만 배고픈 건 아니지?', '혹시 저만 배고픈 건 아니죠?')]"
            d "[ri('둘 다 배고파. 네가 먼저 솔직했을 뿐이지.', '둘 다 배고파요. 리아 씨가 먼저 솔직하셨을 뿐이죠.')]"
            r "[ri('그럼 오늘은 맛있는 거 고른 사람이 이기는 걸로!', '그럼 오늘은 맛있는 거 고른 사람이 이기는 걸로 해요!')]"
            d "[ri('이기면 다음에 또 같이 먹는 거?', '이기면 다음에 또 같이 먹는 건가요?')]"
            r "[ri('...네가 더 큰 걸 걸었네. 좋아.', '...도현 씨가 더 큰 걸 걸었네요. 좋아요.')]"
            d "[ri('난 이거 먹고 싶은데, 너는?', '저는 이거 먹고 싶은데, 리아 씨는요?')]"
            "각자 메뉴를 고르고 가볍게 식사한다. 승패를 정하기보다 다음에 다시 먹고 싶은 것을 이야기했다."
        "[ri('네가 가고 싶었던 데부터 들어 볼래.', '리아 씨가 가고 싶었던 데부터 들어 볼게요.')]":
            $ afterwork_preference = "suggestion"
            r "[ri('회사 뒤에 작은 가게 있어. 마음에 안 들면 바로 바꾸자. 내 취향 시험 아니니까.', '회사 뒤에 작은 가게 있어요. 마음에 안 들면 바로 바꿔요. 제 취향 시험 아니니까요.')]"
            "리아가 작은 가게의 창가 자리를 보여준다."
            if memory.get("c06_ria_place"):
                r "[ri('전에 말했던 창가가 여기야. 오늘은 같이 왔네.', '전에 말씀드렸던 창가가 여기예요. 오늘은 같이 왔네요.')]"
            else:
                r "[ri('여기야. 퇴근하고 혼자 들를 때가 있어.', '여기예요. 퇴근하고 혼자 들를 때가 있어요.')]"
            d "[ri('오늘은 내가 끼어도 되는 자리야?', '오늘은 제가 끼어도 되는 자리인가요?')]"
            r "[ri('내가 부른 사람이 그걸 왜 물어.', '제가 부른 분이 그걸 왜 물어요.')]"
            d "[ri('그럼 다음에는 내가 자주 가는 데도 같이 가자.', '그럼 다음에는 제가 자주 가는 데도 같이 가요.')]"
            r "[ri('벌써 답례 장소 정하는 거야?', '벌써 답례 장소 정하시는 거예요?')]"
            d "[ri('네 취향 듣는 것도 좋지만, 내 것도 알려주고 싶어서.', '리아 씨 취향 듣는 것도 좋지만, 제 것도 알려드리고 싶어서요.')]"
            r "[ri('좋아. 오늘은 내 추천부터. 뭐가 궁금해?', '좋아요. 오늘은 제 추천부터. 뭐가 궁금하세요?')]"
    $ location = "둘이 앉은 자리"
    if c07_person == "ria":
        r "[ri('지난번에 잠깐 나왔던 것보다 오늘은 여유 있네. 너도 이쪽이 좋아?', '지난번에 잠깐 나왔던 것보다 오늘은 여유 있네요. 도현 씨도 이쪽이 좋아요?')]"
    elif c06_person == "ria":
        if c06_topic == "weekend":
            r "[ri('알람 없는 아침 얘기했잖아. 저녁에도 급하지 않은 약속이면 좋겠네.', '알람 없는 아침 얘기했잖아요. 저녁에도 급하지 않은 약속이면 좋겠네요.')]"
        elif c06_topic == "place":
            r "[ri('지난번엔 내가 창가 좋아한다는 얘기 했지. 너는 어떤 자리가 편해?', '지난번엔 제가 창가 좋아한다는 얘기 했죠. 도현 씨는 어떤 자리가 편해요?')]"
        else:
            r "[ri('지난번엔 현장 얘기했으니까, 오늘은 퇴근한 네 얘기가 궁금해.', '지난번엔 현장 얘기했으니까, 오늘은 퇴근한 도현 씨 얘기가 궁금해요.')]"
    elif first_approach == "observe":
        r "[ri('처음에 사람들 움직이는 걸 끝까지 보고 있더라. 원래 궁금한 건 직접 확인하는 편이야?', '처음에 사람들 움직이는 걸 끝까지 보시더라고요. 원래 궁금한 건 직접 확인하는 편이에요?')]"
    elif first_approach == "listen":
        r "[ri('처음에 직원분한테 먼저 물어봤잖아. 나도 그게 빠르다고 생각했어. 오늘은 나한테도 물어봐.', '처음에 직원분한테 먼저 물어보셨잖아요. 저도 그게 빠르다고 생각했어요. 오늘은 저한테도 물어보세요.')]"
    else:
        r "[ri('첫날부터 나한테 역할 나눠 줬잖아. 오늘은 질문부터 나눌까?', '첫날부터 저한테 역할 나눠 주셨잖아요. 오늘은 질문부터 나눌까요?')]"
    d "[ri('오늘도 면접 보는 기분인데.', '오늘도 면접 보는 기분인데요.')]"
    r "[ri('아, 내가 또 질문부터 했네. 미안. 정답 없는 걸로 바꿀게.', '아, 제가 또 질문부터 했네요. 미안해요. 정답 없는 걸로 바꿀게요.')]"
    d "[ri('그럼 틀리면?', '그럼 틀리면요?')]"
    r "[ri('내가 모른 척해 줄게~~', '제가 모른 척해 드릴게요~~')]"
    "도현이 컵을 내려놓자 리아도 입을 다문다. 잠깐 쉬는 사이, 리아가 도현의 입가에 묻은 거품을 발견하고 웃음을 참는다."
    d "[ri('왜? 면접 결과 나왔어?', '왜요? 면접 결과 나왔어요?')]"
    r "[ri('응. 거품 묻히고 진지한 얘기 하는 사람인 걸로~', '네. 거품 묻히고 진지한 얘기 하시는 분인 걸로요~')]"
    "도현이 냅킨으로 입가를 닦았다. 리아가 참던 웃음을 터뜨린다."
    d "[ri('그건 다음 질문 전에 알려 줘도 됐잖아!', '그건 다음 질문 전에 알려 주셔도 됐잖아요!')]"
    r "[ri('조금 더 보고 싶어서. ...아, 거품 얘기야!', '조금 더 보고 싶어서요. ...아, 거품 얘기예요!')]"
    d "[ri('응. 일단 그렇게 알아들을게.', '네. 일단 그렇게 알아들을게요.')]"
    r "[ri('다음에는 오늘 못 간 데 가 볼래?', '다음에는 오늘 못 간 데 가 볼래요?')]"
    d "[ri('좋아. 날짜는 같이 정하자.', '좋아요. 날짜는 같이 정해요.')]"
    r "[ri('응. 그날은 네 컵부터 확인하고~', '네. 그날은 도현 씨 컵부터 확인하고요~')]"
    $ remember("ria_r01_preference",afterwork_preference)
    $ award_once("ria_R01","ria",4,1)
    return

