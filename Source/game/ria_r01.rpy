label ria_r01:
    $ progression_enter("ria_r01")
    $ progression_checkpoint("ria_r01")
    $ chapter = "리아 R01 · 오늘은 동료 둘이"
    $ location = "다음 퇴근길 · 회사 앞"
    "회사 앞 화단에 리아가 걸터앉아 있다. 휴대폰 화면을 끄더니 손을 번쩍 든다."
    r "[ri('도현아! 오늘 바로 집에 가?', '도현 씨! 오늘 바로 집에 가세요?')]"
    d "[ri('...추가 현장 배정이야?', '...추가 현장 배정인가요?')]"
    r "[ri('퇴근했거든~ 이건 업무 아니고 개인 호출!', '퇴근했거든요~ 이건 업무 아니고 개인 호출이에요!')]"
    d "[ri('개인 호출은 사유부터 듣고.', '개인 호출은 사유부터 들을게요.')]"
    if c06_person == "ria" or c07_person == "ria":
        r "[ri('와, 결재 받는 줄. ...지난번에 하다 만 얘기 있잖아. 그거 마저 하자.', '와, 결재 받는 줄 알았어요. ...지난번에 하다 만 얘기 있잖아요. 그거 마저 해요.')]"
    else:
        r "[ri('와, 결재 받는 줄. ...다 같이 있을 땐 못 물어본 게 있어서.', '와, 결재 받는 줄 알았어요. ...다 같이 있을 땐 못 여쭤본 게 있어서요.')]"
    d "[ri('현장에선 목적지부터 통보하더니.', '현장에선 목적지부터 통보하시더니.')]"
    r "[ri('그건 일이고! ...그래서, 어디 가고 싶은데?', '그건 일이고요! ...그래서, 어디 가고 싶으세요?')]"
    dn "무전기를 들고 있을 때보다 훨씬 자신 없는 얼굴이었다. 이쪽이 더 마음에 들었다."
    $ progression_enter("ria_r01.choice01")
    $ progression_checkpoint("ria_r01.choice01")
    menu:
        "[ri('조용한 데. 앉아서 얘기할 수 있는 곳.', '조용한 데요. 앉아서 얘기할 수 있는 곳이요.')]":
            $ afterwork_preference = "quiet"
            r "[ri('오케이. 대신 내가 옆에 앉아도 안 쫓겨나는 데로.', '좋아요. 대신 제가 옆에 앉아도 안 쫓겨나는 데로요.')]"
            "카페 창가에 자리가 두 개 비어 있다. 리아는 맞은편 의자에 가방부터 내려놓는다."
            d "[ri('옆에 앉는다며.', '옆에 앉으신다면서요.')]"
            r "[ri('그걸 듣고 있었어?!', '그걸 듣고 계셨어요?!')]"
            d "[ri('안 쫓겨난다고 보장까지 했는데.', '안 쫓겨난다고 보장까지 하셨는데요.')]"
            "리아가 가방을 도로 집어 들고 옆 의자를 끌어당긴다. 의자 다리가 생각보다 크게 끌렸다."
            r "[ri('...조용한 데 와서 나만 시끄러우면 말해.', '...조용한 데 와서 저만 시끄러우면 말해 주세요.')]"
            d "[ri('그거 들으러 온 건데.', '그거 들으러 온 건데요.')]"
        "[ri('일단 밥. 배고파.', '일단 밥이요. 배고파요.')]":
            $ afterwork_preference = "meal"
            r "[ri('찬성!! 나 지금 무슨 멋있는 말 해도 머릿속은 메뉴판이야.', '찬성이에요!! 저 지금 무슨 멋있는 말 해도 머릿속은 메뉴판이에요.')]"
            "회사 뒤 밥집. 리아는 가방을 옆 의자에 던지듯 내려놓고 메뉴판부터 펼친다."
            r "[ri('혹시 나만 배고픈 거 아니지?', '혹시 저만 배고픈 거 아니죠?')]"
            d "[ri('아니. 네가 티를 더 냈을 뿐이야.', '아니요. 리아 씨가 티를 더 냈을 뿐이에요.')]"
            r "[ri('그럼 내기. 맛있는 거 시킨 사람이 이기기!', '그럼 내기해요. 맛있는 거 시킨 사람이 이기기!')]"
            d "[ri('이기면 뭐 주는데?', '이기면 뭐 주는데요?')]"
            r "[ri('...음. 다음 밥? 잠깐, 이거 내가 손해 보는 내기인데?', '...음. 다음 밥이요? 잠깐, 이거 제가 손해 보는 내기인데요?')]"
            "덮밥과 국수가 나왔다. 한 입씩 바꿔 먹자, 리아는 자기 그릇보다 도현의 얼굴을 본다."
            r "[ri('국수 이겼지? 이겼지?', '국수가 이겼죠? 이겼죠?')]"
            d "[ri('...이겼어.', '...이겼네요.')]"
            r "[ri('좋아! 그럼 다음 가게도 내가 정한다~', '좋아요! 그럼 다음 가게도 제가 정할게요~')]"
            d "[ri('잠깐, 이긴 사람이 사는 거 아니었어?', '잠깐만요, 이긴 사람이 사는 거 아니었어요?')]"
            r "[ri('그런 말 한 적 없는데~', '그런 말 한 적 없는데요~')]"
            "리아가 자기 그릇을 도현 쪽으로 슬쩍 민다. 한 입 더 먹으라는 건지, 증거를 더 보라는 건지는 모르겠다."
        "[ri('네가 가고 싶었던 데.', '리아 씨가 가고 싶었던 데요.')]":
            $ afterwork_preference = "suggestion"
            r "[ri('진짜? 그럼 회사 뒤에 작은 가게. 창가 자리가 진짜 좋거든.', '진짜요? 그럼 회사 뒤에 작은 가게요. 창가 자리가 진짜 좋거든요.')]"
            "골목 안쪽, 간판보다 화분이 먼저 눈에 띄는 가게다. 리아가 창가 자리를 손바닥으로 가리킨다."
            if memory.get("c06_ria_place"):
                r "[ri('전에 말한 창가가 여기야. ...직접 데려오니까 좀 떨리네.', '전에 말씀드린 창가가 여기예요. ...직접 모시고 오니까 좀 떨리네요.')]"
            else:
                r "[ri('여기. 퇴근하고 혼자 몰래 오는 데야.', '여기요. 퇴근하고 혼자 몰래 오는 데예요.')]"
            d "[ri('나한테 알려 줘도 되는 데야?', '저한테 알려 주셔도 되는 데예요?')]"
            r "[ri('불러 놓고 그걸 왜 물어.', '불러 놓고 그걸 왜 물어요.')]"
            d "[ri('그럼 다음엔 내 단골도 공개할게.', '그럼 다음엔 제 단골도 공개할게요.')]"
            r "[ri('벌써 답례 장소 정하는 거야? 빠르네~', '벌써 답례 장소 정하시는 거예요? 빠르시네요~')]"
            d "[ri('받기만 하면 빚지는 기분이라.', '받기만 하면 빚지는 기분이라서요.')]"
            r "[ri('좋아. 그럼 오늘은 내 가게 소개부터. 뭐 궁금해?', '좋아요. 그럼 오늘은 제 가게 소개부터요. 뭐 궁금하세요?')]"
    $ location = "둘이 앉은 자리"
    "도현은 따뜻한 라테, 리아는 이름이 한 줄을 넘는 시즌 음료를 시켰다."
    if c07_person == "ria":
        r "[ri('지난번엔 쫓기듯 잠깐 나왔잖아. 오늘은 시계 안 봐도 되지?', '지난번엔 쫓기듯 잠깐 나왔잖아요. 오늘은 시계 안 봐도 되죠?')]"
    elif c06_person == "ria":
        if c06_topic == "weekend":
            r "[ri('알람 없는 아침 얘기했었잖아. 저녁도 그렇게 느긋하면 좋겠다.', '알람 없는 아침 얘기했었잖아요. 저녁도 그렇게 느긋하면 좋겠어요.')]"
        elif c06_topic == "place":
            r "[ri('나 창가파인 거 저번에 말했지. 넌 무슨 파야?', '저 창가파인 거 저번에 말씀드렸죠. 도현 씨는 무슨 파예요?')]"
        else:
            r "[ri('저번엔 현장 얘기만 했으니까. 오늘은 퇴근한 너 얘기.', '저번엔 현장 얘기만 했으니까요. 오늘은 퇴근한 도현 씨 얘기요.')]"
    elif first_approach == "observe":
        r "[ri('첫날에 사람들 동선 끝까지 보고 있더라. 원래 눈으로 봐야 믿는 타입?', '첫날에 사람들 동선 끝까지 보시더라고요. 원래 눈으로 봐야 믿는 타입이에요?')]"
    elif first_approach == "listen":
        r "[ri('첫날에 직원분한테 바로 물어봤잖아. 그거 좋았어. 그러니까 오늘은 나한테 물어봐.', '첫날에 직원분한테 바로 물어보셨잖아요. 그거 좋았어요. 그러니까 오늘은 저한테 물어보세요.')]"
    else:
        r "[ri('첫날부터 나한테 일 나눠 줬잖아. 오늘은 질문을 나눠 볼까?', '첫날부터 저한테 일 나눠 주셨잖아요. 오늘은 질문을 나눠 볼까요?')]"
    d "[ri('...이거 면접이야?', '...이거 면접인가요?')]"
    r "[ri('헉. 나 또 질문 폭격했지. 취소! 지금부턴 아무 말 대잔치.', '헉. 저 또 질문 폭격했죠. 취소할게요! 지금부턴 아무 말 대잔치예요.')]"
    d "[ri('아무 말도 틀리면?', '아무 말도 틀리면요?')]"
    r "[ri('그땐 내가 못 들은 척해 줄게~', '그땐 제가 못 들은 척해 드릴게요~')]"
    "도현이 잔을 내려놓았다. 리아가 무슨 말을 하려다 입술을 꾹 다문다. 어깨가 조금씩 떨린다."
    d "[ri('왜. 면접 결과 나왔어?', '왜요. 면접 결과 나왔어요?')]"
    r "[ri('응. 입가에 거품 달고 진지한 얘기 하는 사람. 합격~', '네. 입가에 거품 달고 진지한 얘기 하시는 분. 합격이에요~')]"
    "도현이 급히 냅킨으로 입가를 닦는다. 리아가 결국 웃음을 터뜨린다."
    d "[ri('그걸 지금 말해? 아까부터 있었지?', '그걸 지금 말해요? 아까부터 있었죠?')]"
    r "[ri('귀여워서 좀 보려고. ...아니, 거품이! 거품이 귀엽다고!', '귀여워서 좀 보려고요. ...아니, 거품이요! 거품이 귀엽다고요!')]"
    dn "변명이 본문보다 길었다. 오늘은 내가 못 들은 척해 주기로 했다."
    d "[ri('응. 거품 얘기로 알아들을게.', '네. 거품 얘기로 알아들을게요.')]"
    r "[ri('...다음엔 오늘 못 간 데 가 볼래?', '...다음엔 오늘 못 간 데 가 볼래요?')]"
    d "[ri('좋아. 이번엔 거울 있는 자리로.', '좋아요. 이번엔 거울 있는 자리로요.')]"
    r "[ri('그날은 네 입가부터 검사한다~', '그날은 도현 씨 입가부터 검사할 거예요~')]"
    $ remember("ria_r01_preference",afterwork_preference)
    $ award_once("ria_R01","ria",4,1)
    $ progression_note_ending()
    return
